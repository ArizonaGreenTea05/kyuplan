<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Liquid Glass", light: same keys as Colors.Win10.Light.xaml. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#14213D" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4D5B7C" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6E7A98" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#9AA4BD" />

    <!-- Surfaces -->
    <LinearGradientBrush x:Key="AppWindowBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F7D5E8" Offset="0" /><GradientStop Color="#CFE2FA" Offset="0.55" /><GradientStop Color="#CDF3E3" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#F4F7FD" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#66466A99" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F4F7FD" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#66466A99" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#66466A99" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#4D5B7C" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#66466A99" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#4D5B7C" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#4D5B7C" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#14213D" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#66466A99" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#88466A99" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#AA466A99" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#66466A99" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#14213D" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#14213D" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#4D5B7C" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#B3FFFFFF" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
