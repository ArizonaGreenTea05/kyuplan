<UserControl x:Class="Kyuplan.Client.WpfApp.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,6,24,32">

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{loc:Loc Preferences_Lede}" Style="{StaticResource LedeText}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <ctl:ResponsiveGrid MinItemWidth="360" Gap="14" Margin="0,20,0,0">

                    <!-- The user's own theme, kept with the account (see OnThemeChanged); the first entry follows the administrators' default. -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Shell_Design}" Style="{StaticResource SectionTitleText}" />

                            <ComboBox x:Name="ThemeBox" ItemsSource="{Binding Themes.Choices}"
                                      SelectedItem="{Binding Themes.Selected, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectionChanged="OnThemeChanged"
                                      AutomationProperties.Name="{loc:Loc Shell_Design}" />
                            <TextBlock Text="{loc:Loc Shell_DesignHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Themes.ErrorMessage}" Style="{StaticResource ProblemText}" TextWrapping="Wrap"
                                       Visibility="{Binding Themes.ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                            <!-- Only where the design has a dark mode: otherwise a click would change nothing. -->
                            <Button Click="OnToggleTheme" HorizontalAlignment="Left" Margin="0,14,0,0" ToolTip="{loc:Loc Shell_ThemeHint}"
                                    IsEnabled="{Binding Theme.SupportsDark, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextBlock}">
                                                <Setter Property="Text" Value="&#xE708;" /> <!-- moon: switch to dark -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Theme.IsDark, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Text" Value="&#xE706;" /> <!-- sun: switch to light -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{loc:Loc Shell_Theme}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- The user's own language, kept with the account; the open window switches at once. -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Preferences_LanguageTitle}" Style="{StaticResource SectionTitleText}" />

                            <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectionChanged="OnLanguageChanged"
                                      AutomationProperties.Name="{loc:Loc Shell_Language}" />
                            <TextBlock Text="{loc:Loc Shell_LanguageHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                </ctl:ResponsiveGrid>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{loc:Loc Shell_Loading}" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
