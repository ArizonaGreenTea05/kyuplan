<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Design "Liquid Glass": translucent panels over a soft colour field. Large radii, light 1 px edges, pill-shaped tabs and
         sliders. WPF cannot blur what is behind a control, so the glass is made of see-through white (Colors.Glass.Light/Dark.xaml) over
         the gradient of the window. The controls are Controls.Classic.xaml. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Classic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Shapes ===== -->
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CtlInnerCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="CtlInputCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CtlCheckCornerRadius">6</CornerRadius>
    <Thickness x:Key="CtlBorderThickness">1</Thickness>
    <Thickness x:Key="CtlGlyphBorderThickness">1.5</Thickness>
    <sys:Double x:Key="CtlGlyphStroke">1.5</sys:Double>
    <sys:Double x:Key="CtlGlyphSize">20</sys:Double>
    <Thickness x:Key="CtlButtonPadding">14,7,14,8</Thickness>
    <Thickness x:Key="CtlInputPadding">11,6,10,7</Thickness>
    <sys:Double x:Key="CtlPopupShadowOpacity">0.18</sys:Double>

    <Visibility x:Key="CtlScrollArrowVisibility">Collapsed</Visibility>
    <sys:Double x:Key="CtlScrollSize">14</sys:Double>
    <Thickness x:Key="CtlScrollThumbMarginV">3,0</Thickness>
    <Thickness x:Key="CtlScrollThumbMarginH">0,3</Thickness>
    <CornerRadius x:Key="CtlScrollThumbCornerRadius">5</CornerRadius>

    <sys:Double x:Key="CtlProgressHeight">8</sys:Double>
    <Thickness x:Key="CtlProgressBorderThickness">0</Thickness>
    <CornerRadius x:Key="CtlProgressCornerRadius">4</CornerRadius>
    <sys:Double x:Key="CtlSliderTrackHeight">6</sys:Double>
    <sys:Double x:Key="CtlSliderThumbWidth">20</sys:Double>
    <sys:Double x:Key="CtlSliderThumbHeight">20</sys:Double>
    <CornerRadius x:Key="CtlSliderThumbCornerRadius">10</CornerRadius>

    <!-- ===== The app's own tokens (see Design.Fluent.xaml) ===== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="AppFontSize">14</sys:Double>
    <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
    <Visibility x:Key="AppNavIndicatorVisibility">Visible</Visibility>
    <CornerRadius x:Key="AppContentCornerRadius">18,0,0,0</CornerRadius>
    <Thickness x:Key="AppContentBorderThickness">1,1,0,0</Thickness>
    <CornerRadius x:Key="AppPillCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="AppSwatchCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="AppTabCornerRadius">12</CornerRadius>
    <Thickness x:Key="AppTabBorderThickness">0,0,0,2</Thickness>
    <Thickness x:Key="AppTabContentBorderThickness">0</Thickness>
    <Thickness x:Key="AppTabPadding">12,8,12,6</Thickness>

    <!-- A keyboard focus frame outside the control, solid, as in Windows 10. -->
    <Style x:Key="DefaultControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" RadiusX="12" RadiusY="12" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Type ramp: Segoe UI, light for the big sizes ===== -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semilight" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>
</ResourceDictionary>
