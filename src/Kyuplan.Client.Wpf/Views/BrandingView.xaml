<UserControl x:Class="Kyuplan.Client.WpfApp.Views.BrandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Kyuplan.Contracts;assembly=Kyuplan.Contracts"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared">

    <UserControl.Resources>
        <!-- Which of the two sentences about the saved state is true. -->
        <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource LedeText}">
            <Setter Property="Text" Value="{loc:Loc Branding_StateDefault}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                    <Setter Property="Text" Value="{loc:Loc Branding_StateCustom}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The surface an image is meant for, whichever theme the program is in: the logos for light surfaces are shown on white,
             the others on near-black. -->
        <Style x:Key="SlotPreview" TargetType="Border">
            <Setter Property="Height" Value="132" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="TextElement.Foreground" Value="#66655D" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OnDark}" Value="True">
                    <Setter Property="Background" Value="#050301" />
                    <Setter Property="TextElement.Foreground" Value="#A3A198" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Upload for a slot without an image, replace for one with. -->
        <Style x:Key="UploadText" TargetType="TextBlock">
            <Setter Property="Text" Value="{loc:Loc Branding_Upload}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasImage}" Value="True">
                    <Setter Property="Text" Value="{loc:Loc Branding_Replace}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,6,24,32">

                <!-- Title + back to the API's settings -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Command="{Binding AskResetCommand}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="ToolTip" Value="{loc:Loc Branding_ResetHint}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanEdit}" Value="True" />
                                            <Condition Binding="{Binding IsLoaded}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <!-- The hint says why the button is off: there is nothing saved to forget. -->
                                    <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE7A7;" />
                            <TextBlock Text="{loc:Loc Branding_Reset}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc Branding_Lede}" Style="{StaticResource LedeText}" />
                    </StackPanel>
                </DockPanel>

                <!-- Somebody who may not see the branding gets here only by a mistake of the navigation: the API would refuse them anyway. -->
                <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                           Text="{loc:Loc Page_NotAllowed}"
                           Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">

                    <!-- What went wrong / what was achieved. Trying again only makes sense while there is nothing to show: a failed
                         save or upload is not helped by loading again. -->
                    <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" Content="{loc:Loc Shell_TryAgain}" Margin="12,0,0,0"
                                    Visibility="{Binding IsLoaded, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource NoticeBorder}" Margin="0,16,0,0"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Border>

                    <!-- Nothing is forgotten before this question is answered: the uploaded images cannot be got back -->
                    <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                            Visibility="{Binding IsConfirmingReset, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Command="{Binding ConfirmResetCommand}" Content="{loc:Loc Branding_ConfirmYes}" />
                                <Button Command="{Binding CancelResetCommand}" Content="{loc:Loc Branding_Cancel}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Branding_ConfirmReset}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource StateText}" Margin="0,16,0,0" />

                        <!-- The texts and the colour: saved together -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Branding_TextsTitle}" Style="{StaticResource SectionTitleText}" />

                                <ctl:ResponsiveGrid MinItemWidth="340" Gap="24">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Branding_ProductName}" Style="{StaticResource FieldLabelText}" />
                                        <TextBox MaxLength="{x:Static contracts:BrandingRules.MaxProductNameLength}"
                                                 IsEnabled="{Binding CanEdit}"
                                                 AutomationProperties.Name="{loc:Loc Branding_ProductName}"
                                                 Text="{Binding FormProductName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding ProductNameProblem}" Style="{StaticResource ProblemText}"
                                                   Visibility="{Binding ProductNameProblem, Converter={StaticResource StringToVisibility}}" />
                                        <TextBlock Text="{loc:Loc Branding_ProductNameHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Branding_OrganizationName}" Style="{StaticResource FieldLabelText}" />
                                        <TextBox MaxLength="{x:Static contracts:BrandingRules.MaxOrganizationNameLength}"
                                                 IsEnabled="{Binding CanEdit}"
                                                 AutomationProperties.Name="{loc:Loc Branding_OrganizationName}"
                                                 Text="{Binding FormOrganizationName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding OrganizationNameProblem}" Style="{StaticResource ProblemText}"
                                                   Visibility="{Binding OrganizationNameProblem, Converter={StaticResource StringToVisibility}}" />
                                        <TextBlock Text="{loc:Loc Branding_OrganizationNameHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Branding_Currency}" Style="{StaticResource FieldLabelText}" />
                                        <TextBox MaxLength="{x:Static contracts:BrandingRules.MaxCurrencyLength}"
                                                 IsEnabled="{Binding CanEdit}"
                                                 AutomationProperties.Name="{loc:Loc Branding_Currency}"
                                                 Text="{Binding FormCurrency, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding CurrencyProblem}" Style="{StaticResource ProblemText}"
                                                   Visibility="{Binding CurrencyProblem, Converter={StaticResource StringToVisibility}}" />
                                        <TextBlock Text="{loc:Loc Branding_CurrencyHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ctl:ResponsiveGrid>

                                <!-- The colour: typed as #RGB or #RRGGBB, or picked from the swatches -->
                                <StackPanel HorizontalAlignment="Left" Width="480" Margin="0,16,0,0">
                                    <TextBlock Text="{loc:Loc Branding_AccentColor}" Style="{StaticResource FieldLabelText}" />
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource PreviewSwatch}"
                                                Background="{Binding AccentPickerValue, Converter={StaticResource HexToBrush}}" />
                                        <TextBox VerticalContentAlignment="Center" MaxLength="7" AutomationProperties.Name="{loc:Loc Branding_AccentColor}"
                                                 IsEnabled="{Binding CanEdit}"
                                                 Text="{Binding FormAccentColor, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding AccentColorProblem}" Style="{StaticResource ProblemText}"
                                               Visibility="{Binding AccentColorProblem, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{loc:Loc Branding_AccentColorHint}" Style="{StaticResource MutedText}" Margin="0,4,0,8"
                                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl Style="{StaticResource SwatchList}" ItemsSource="{x:Static vm:BrandingAdminViewModel.AccentPresets}"
                                                  Tag="{Binding PickAccentColorCommand}"
                                                  Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- The theme of each client for users who picked none -->
                                <StackPanel HorizontalAlignment="Left" Width="480" Margin="0,16,0,0">
                                    <TextBlock Text="{loc:Loc Branding_ThemesTitle}" Style="{StaticResource FieldLabelText}" />
                                    <TextBlock Text="{loc:Loc Branding_DefaultWebTheme}" Style="{StaticResource MutedText}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding WebThemes}" SelectedItem="{Binding SelectedWebTheme}" DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc Branding_DefaultWebTheme}" />
                                    <TextBlock Text="{loc:Loc Branding_DefaultWindowsTheme}" Style="{StaticResource MutedText}" Margin="0,8,0,2" />
                                    <ComboBox ItemsSource="{Binding WindowsThemes}" SelectedItem="{Binding SelectedWindowsTheme}" DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc Branding_DefaultWindowsTheme}" />
                                    <TextBlock Text="{loc:Loc Branding_ThemesLede}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>

                                <Button Command="{Binding SaveCommand}" Content="{loc:Loc Branding_Save}" Style="{StaticResource AccentButtonStyle}"
                                        IsDefault="True" HorizontalAlignment="Left" Margin="0,20,0,0"
                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- The images: picked or taken away first (the preview shows how they will look), saved together -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Branding_ImagesTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ImagesLede}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />

                                <ItemsControl ItemsSource="{Binding Images}" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ctl:ResponsiveGrid MinItemWidth="290" Gap="18" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BrandingImageRow}">
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14">
                                                <!-- The cards of a row are equally tall, and what is docked to the bottom lines up across them
                                                     whatever the length of the hints above. -->
                                                <DockPanel>
                                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"
                                                               Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                                        <Button Click="OnUploadClick" Margin="0,0,8,0"
                                                                IsEnabled="{Binding DataContext.CanUpload, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE898;" />
                                                                <TextBlock Style="{StaticResource UploadText}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE74D;" />
                                                                <TextBlock Text="{loc:Loc Branding_Remove}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <!-- Only while there is a change to drop -->
                                                        <Button Command="{Binding DataContext.UndoImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Margin="8,0,0,0"
                                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE7A7;" />
                                                                <TextBlock Text="{loc:Loc Branding_Undo}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>

                                                    <Border DockPanel.Dock="Bottom" Style="{StaticResource SlotPreview}" Margin="0,10,0,0">
                                                        <ctl:ImagePreview Source="{Binding PreviewUrl}" EmptyText="{Binding EmptyText}"
                                                                          FailedText="{loc:Loc Branding_NoPreview}" />
                                                    </Border>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                        <TextBlock Text="{loc:Loc Branding_NotSavedYet}" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Command="{Binding SaveImagesCommand}" Content="{loc:Loc Branding_Save}" Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Left" Margin="0,20,0,0"
                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Theme packs: the installed ones, and (with themes.edit) installing and deleting them -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Themes_Title}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" />
                                <TextBlock Text="{loc:Loc Themes_Lede}" Style="{StaticResource MutedText}" Margin="0,0,0,14" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding ThemePacks}" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThemePackRow}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <!-- Only an uploaded theme can be deleted; a built-in one and one of a GitHub theme pack have no button at all -->
                                                <Button Grid.Column="1" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.DeleteThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUploaded}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE74D;" />
                                                        <TextBlock Text="{loc:Loc Themes_Delete}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Click="OnInstallThemeClick" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        IsEnabled="{Binding CanInstallTheme}"
                                        Visibility="{Binding CanManageThemes, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE898;" />
                                        <TextBlock Text="{loc:Loc Themes_Install}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- GitHub theme packs: repositories whose themes are read now and then (themes.edit) -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                                Visibility="{Binding CanManageThemes, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc ThemeSources_Title}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ThemeSourcesLede}" Style="{StaticResource MutedText}" Margin="0,0,0,14" TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding ThemeSources}" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThemeSourceRow}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Problem}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                               Visibility="{Binding Problem, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.RefreshThemeSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE72C;" />
                                                        <TextBlock Text="{loc:Loc ThemeSources_Refresh}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeleteThemeSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE74D;" />
                                                        <TextBlock Text="{loc:Loc ThemeSources_Remove}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{loc:Loc ThemeSources_Url}" Style="{StaticResource FieldLabelText}" Margin="0,12,0,0" />
                                <TextBox AutomationProperties.Name="{loc:Loc ThemeSources_Url}" IsEnabled="{Binding CanInstallTheme}"
                                         Text="{Binding NewThemeSourceUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding NewThemeSourceUrlProblem}" Style="{StaticResource ProblemText}"
                                           Visibility="{Binding NewThemeSourceUrlProblem, Converter={StaticResource StringToVisibility}}" />
                                <Button Command="{Binding AddThemeSourceCommand}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE710;" />
                                        <TextBlock Text="{loc:Loc ThemeSources_Add}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{loc:Loc Shell_Loading}" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
