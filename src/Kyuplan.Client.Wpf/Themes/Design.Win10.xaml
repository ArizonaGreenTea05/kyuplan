<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Design "Windows 10": flat and square. Segoe UI, hard corners, thick 2 px frames that light up when the pointer comes near,
         tick boxes and radio buttons with an outline, thin scroll bars without arrows, a grey navigation pane next to a white page.
         The controls are Controls.Classic.xaml; the colours are Colors.Win10.Light/Dark.xaml (swapped with the mode) and the
         accent colour ThemeService makes the rest of. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Classic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Shapes ===== -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CtlInnerCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CtlInputCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CtlCheckCornerRadius">0</CornerRadius>
    <Thickness x:Key="CtlBorderThickness">2</Thickness>
    <Thickness x:Key="CtlGlyphBorderThickness">2</Thickness>
    <sys:Double x:Key="CtlGlyphStroke">2</sys:Double>
    <sys:Double x:Key="CtlGlyphSize">20</sys:Double>
    <Thickness x:Key="CtlButtonPadding">11,5,11,6</Thickness>
    <Thickness x:Key="CtlInputPadding">9,4,8,5</Thickness>
    <sys:Double x:Key="CtlPopupShadowOpacity">0.25</sys:Double>

    <Visibility x:Key="CtlScrollArrowVisibility">Collapsed</Visibility>
    <sys:Double x:Key="CtlScrollSize">14</sys:Double>
    <Thickness x:Key="CtlScrollThumbMarginV">4,0</Thickness>
    <Thickness x:Key="CtlScrollThumbMarginH">0,4</Thickness>
    <CornerRadius x:Key="CtlScrollThumbCornerRadius">0</CornerRadius>

    <sys:Double x:Key="CtlProgressHeight">4</sys:Double>
    <Thickness x:Key="CtlProgressBorderThickness">0</Thickness>
    <CornerRadius x:Key="CtlProgressCornerRadius">0</CornerRadius>
    <sys:Double x:Key="CtlSliderTrackHeight">4</sys:Double>
    <sys:Double x:Key="CtlSliderThumbWidth">10</sys:Double>
    <sys:Double x:Key="CtlSliderThumbHeight">22</sys:Double>
    <CornerRadius x:Key="CtlSliderThumbCornerRadius">0</CornerRadius>

    <!-- ===== The app's own tokens (see Design.Fluent.xaml) ===== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="AppFontSize">14</sys:Double>
    <FontFamily x:Key="SymbolThemeFontFamily">Segoe MDL2 Assets</FontFamily>
    <Visibility x:Key="AppNavIndicatorVisibility">Visible</Visibility>
    <CornerRadius x:Key="AppContentCornerRadius">0</CornerRadius>
    <Thickness x:Key="AppContentBorderThickness">0</Thickness>
    <CornerRadius x:Key="AppPillCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="AppSwatchCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="AppTabCornerRadius">0</CornerRadius>
    <Thickness x:Key="AppTabBorderThickness">0,0,0,2</Thickness>
    <Thickness x:Key="AppTabContentBorderThickness">0</Thickness>
    <Thickness x:Key="AppTabPadding">12,8,12,6</Thickness>

    <!-- A keyboard focus frame outside the control, solid, as in Windows 10. -->
    <Style x:Key="DefaultControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Type ramp: Segoe UI, light for the big sizes ===== -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Semilight" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>
</ResourceDictionary>
