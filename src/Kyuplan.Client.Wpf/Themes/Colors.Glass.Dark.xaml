<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Liquid Glass", dark: same keys as Colors.Win10.Light.xaml. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F4F6FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C6CBE6" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#98A0C8" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6F779C" />

    <!-- Surfaces -->
    <LinearGradientBrush x:Key="AppWindowBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B1740" Offset="0" /><GradientStop Color="#0F3358" Offset="0.55" /><GradientStop Color="#0E4A4A" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#2A2F55" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2A2F55" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#70FFFFFF" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#C6CBE6" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#C6CBE6" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#C6CBE6" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#F4F6FF" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#70FFFFFF" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#F4F6FF" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#F4F6FF" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#C6CBE6" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#38FFFFFF" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
