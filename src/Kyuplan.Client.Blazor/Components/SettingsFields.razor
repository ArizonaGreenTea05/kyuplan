@implements IDisposable
@using System.ComponentModel

@* The settings as cards: the same on the setup screen and on the settings page. Each field says what is wrong with it as soon as it is. *@

<section class="card card-form" aria-labelledby="set-databases">
    <h2 id="set-databases">@Strings.Settings_DatabasesTitle</h2>

    <label class="field">
        <span>@Strings.Settings_DatabasePath</span>
        <input type="text" autocomplete="off" spellcheck="false" disabled="@Disabled" @bind="Form.DatabasePath" @bind:event="oninput" />
        @if (Form.DatabasePathProblem is { } problem)
        {
            <p class="field-error" role="alert">@problem</p>
        }
        else
        {
            <small>@Strings.Settings_DatabasePathHint</small>
        }
    </label>

    <label class="field">
        <span>@Strings.Settings_AccountsDatabasePath</span>
        <input type="text" autocomplete="off" spellcheck="false" disabled="@Disabled" @bind="Form.AccountsDatabasePath" @bind:event="oninput" />
        @if (Form.AccountsDatabasePathProblem is { } accountsProblem)
        {
            <p class="field-error" role="alert">@accountsProblem</p>
        }
        else
        {
            <small>@Strings.Settings_AccountsDatabasePathHint</small>
        }
    </label>
</section>

<section class="card card-form" aria-labelledby="set-spond">
    <h2 id="set-spond">@Strings.Settings_DataSource</h2>

    <label class="field">
        <span>@Strings.Settings_DataSource</span>
        <select value="@Form.DataSource" disabled="@Disabled" @onchange="e => Form.DataSource = e.Value?.ToString() ?? DataSourceKinds.Spond">
            @foreach (var kind in Form.DataSources)
            {
                <option value="@kind">@Form.DataSourceText(kind)</option>
            }
        </select>
        <small>@Form.DataSourceHint</small>
    </label>

    @if (Form.IsCustomSource)
    {
        <label class="field">
            <span>@Strings.Settings_CustomScript</span>
            <textarea class="script-box" rows="18" spellcheck="false" autocomplete="off" disabled="@(Disabled || Form.CustomScriptHidden)" @bind="Form.CustomScript" @bind:event="oninput"></textarea>
            @if (Form.CustomScriptHidden)
            {
                <small>@Strings.Settings_ScriptHidden</small>
            }
            else if (Form.CustomScriptProblem is { } scriptProblem)
            {
                <p class="field-error" role="alert">@scriptProblem</p>
            }
            else
            {
                <small>@Strings.Settings_CustomScriptHint</small>
            }
        </label>
        @if (Form.CustomScriptWarning is { } scriptWarning)
        {
            <p class="hint" role="status">@scriptWarning</p>
        }
        <div class="form-actions">
            <button type="button" class="btn secondary" disabled="@(Disabled || Form.CustomScriptHidden)" @onclick="() => Form.InsertScriptTemplateCommand.Execute(null)">@Strings.Settings_ScriptTemplate</button>
        </div>

        <h3>@Strings.Settings_ScriptSecrets</h3>
        <p class="hint">@Strings.Settings_ScriptSecretsHint</p>

        @foreach (var secret in Form.ScriptSecrets)
        {
            <div class="grid two">
                <label class="field">
                    <span>@Strings.Settings_ScriptSecretName</span>
                    <input type="text" autocomplete="off" spellcheck="false" disabled="@Disabled" @bind="secret.Name" @bind:event="oninput" />
                </label>

                <label class="field">
                    <span>@Strings.Settings_ScriptSecretValue</span>
                    <PasswordInput autocomplete="new-password" disabled="@Disabled" @bind-Value="secret.Value" />
                    @if (secret.HasValue)
                    {
                        <small>@Strings.Settings_ScriptSecretStored</small>
                    }
                </label>
            </div>

            <div class="form-actions">
                <button type="button" class="btn secondary" disabled="@Disabled" @onclick="() => Form.RemoveScriptSecretCommand.Execute(secret)">@Strings.Settings_ScriptSecretRemove</button>
            </div>
        }

        @if (Form.ScriptSecretsProblem is { } secretsProblem)
        {
            <p class="field-error" role="alert">@secretsProblem</p>
        }

        <div class="form-actions">
            <button type="button" class="btn secondary" disabled="@(Disabled || Form.ScriptSecrets.Count >= SettingsRules.MaxScriptSecrets)" @onclick="() => Form.AddScriptSecretCommand.Execute(null)">@Strings.Settings_ScriptSecretAdd</button>
        </div>
    }

    @if (Form.IsMissingPlugin)
    {
        <p class="field-error" role="alert">@Strings.Settings_DataSourceHint_missing</p>
    }

    @* The settings of the data source of a plugin: the plugin describes the form in JSON, the same way for every plugin. *@
    @if (Form.PluginForm is { } pluginForm)
    {
        <PluginItems Items="pluginForm.Items" Disabled="Disabled" />
    }

    @if (Form.IsPluginSource)
    {
        <label class="field">
            <span>@Strings.Settings_UnregisteredSubGroup</span>
            <select value="@Form.UnregisteredSubGroup" disabled="@Disabled" @onchange="e => Form.UnregisteredSubGroup = e.Value?.ToString() ?? string.Empty">
                <option value="">@Strings.Settings_NoSubGroup</option>
                @foreach (var name in Form.SubGroupChoices)
                {
                    <option value="@name">@name</option>
                }
            </select>
            <small>@Strings.Settings_UnregisteredSubGroupHint</small>
        </label>
    }
</section>

<section class="card card-form" aria-labelledby="set-statistics">
    <h2 id="set-statistics">@Strings.Settings_StatisticsTitle</h2>

    <div class="grid two">
        <label class="field">
            <span>@Strings.Settings_TimeZone</span>
            <input type="text" autocomplete="off" spellcheck="false" disabled="@Disabled" @bind="Form.TimeZone" @bind:event="oninput" />
            @if (Form.TimeZoneProblem is { } zoneProblem)
            {
                <p class="field-error" role="alert">@zoneProblem</p>
            }
            else
            {
                <small>@Strings.Settings_TimeZoneHint</small>
            }
        </label>

        <label class="field">
            <span>@Strings.Settings_ExamKeyword</span>
            <input type="text" autocomplete="off" maxlength="@SettingsRules.MaxTextLength" disabled="@Disabled" @bind="Form.ExamKeyword" @bind:event="oninput" />
            <small>@Strings.Settings_ExamKeywordHint</small>
        </label>
    </div>

    <div class="grid two">
        <label class="field">
            <span>@Strings.Settings_MinAttendance</span>
            <input type="number" min="0" max="100" disabled="@Disabled" @bind="Form.DefaultMinAttendancePercent" />
            @if (Form.PercentProblem is { } percentProblem)
            {
                <p class="field-error" role="alert">@percentProblem</p>
            }
        </label>

        <label class="field">
            <span>@Strings.Settings_MinInvited</span>
            <input type="number" min="0" max="1000" disabled="@Disabled" @bind="Form.DefaultMinInvitedEvents" />
            @if (Form.InvitedEventsProblem is { } invitedProblem)
            {
                <p class="field-error" role="alert">@invitedProblem</p>
            }
        </label>
    </div>

    <div class="grid two">
        <label class="field">
            <span>@Strings.Settings_DefaultEventStars</span>
            <input type="number" min="0" max="5" step="0.1" disabled="@Disabled" @bind="Form.DefaultEventStars" />
            <small>@Strings.Settings_DefaultEventStarsHint</small>
            @if (Form.DefaultEventStarsProblem is { } eventStarsProblem)
            {
                <p class="field-error" role="alert">@eventStarsProblem</p>
            }
        </label>

        <label class="field">
            <span>@Strings.Settings_ExamMinStars</span>
            <input type="number" min="0" max="5" step="0.1" disabled="@Disabled" @bind="Form.ExamMinAverageStars" />
            <small>@Strings.Settings_ExamMinStarsHint</small>
            @if (Form.ExamMinAverageStarsProblem is { } minStarsProblem)
            {
                <p class="field-error" role="alert">@minStarsProblem</p>
            }
        </label>
    </div>
</section>

@if (!Form.IsManualSource)
{
<section class="card card-form" aria-labelledby="set-sync">
    <h2 id="set-sync">@Strings.Settings_SyncTitle</h2>

    <label class="check">
        <input type="checkbox" disabled="@Disabled" @bind="Form.SyncEnabled" />
        <span>@Strings.Settings_SyncEnabled<small>@Strings.Settings_SyncEnabledHint</small></span>
    </label>

    @if (Form.SyncEnabled)
    {
        <label class="field">
            <span>@Strings.Settings_SyncInterval</span>
            <input type="number" min="0" max="@SettingsRules.MaxSyncIntervalMinutes" disabled="@Disabled" @bind="Form.SyncIntervalMinutes" />
            @if (Form.SyncIntervalProblem is { } intervalProblem)
            {
                <p class="field-error" role="alert">@intervalProblem</p>
            }
            else
            {
                <small>@Strings.Settings_SyncIntervalHint</small>
            }
        </label>
    }
</section>
}

<section class="card card-form" aria-labelledby="set-security">
    <h2 id="set-security">@Strings.Settings_SecurityTitle</h2>

    <label class="field">
        <span>@Strings.Settings_AllowedHosts</span>
        <input type="text" autocomplete="off" spellcheck="false" disabled="@Disabled" @bind="Form.AllowedHosts" @bind:event="oninput" />
        @if (Form.AllowedHostsProblem is { } hostsProblem)
        {
            <p class="field-error" role="alert">@hostsProblem</p>
        }
        else
        {
            <small>@Strings.Settings_AllowedHostsHint</small>
        }
    </label>

    <label class="field">
        <span>@Strings.Settings_PublicUrl</span>
        <input type="url" autocomplete="off" spellcheck="false" disabled="@Disabled" @bind="Form.PublicUrl" @bind:event="oninput" />
        @if (Form.PublicUrlProblem is { } publicUrlProblem)
        {
            <p class="field-error" role="alert">@publicUrlProblem</p>
        }
        else
        {
            <small>@Strings.Settings_PublicUrlHint</small>
        }
    </label>

    <label class="check">
        <input type="checkbox" disabled="@Disabled" @bind="Form.MetricsEnabled" />
        <span>@Strings.Settings_MetricsEnabled<small>@Strings.Settings_MetricsEnabledHint</small></span>
    </label>

    @if (Form.MetricsEnabled)
    {
        <label class="field">
            <span>@Strings.Settings_MetricsToken</span>
            <input type="password" autocomplete="new-password" spellcheck="false" disabled="@Disabled" @bind="Form.MetricsToken" @bind:event="oninput" />
            @if (Form.MetricsTokenProblem is { } tokenProblem)
            {
                <p class="field-error" role="alert">@tokenProblem</p>
            }
            else
            {
                <small>@(Form.HasMetricsToken ? Strings.Settings_MetricsTokenStored : Strings.Settings_MetricsTokenHint)</small>
            }
        </label>
    }
</section>

@code {
    [Parameter, EditorRequired] public SettingsForm Form { get; set; } = default!;

    [Parameter] public bool Disabled { get; set; }

    private SettingsForm? _observed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_observed, Form)) return;

        if (_observed is not null) _observed.PropertyChanged -= OnFormChanged;
        _observed = Form;
        _observed.PropertyChanged += OnFormChanged;
    }

    private void OnFormChanged(object? sender, PropertyChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_observed is not null) _observed.PropertyChanged -= OnFormChanged;
    }
}
