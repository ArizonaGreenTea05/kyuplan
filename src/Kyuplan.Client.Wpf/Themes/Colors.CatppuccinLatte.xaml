<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Catppuccin Latte" (light only): same keys as Colors.Win10.Light.xaml. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#4C4F69" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6C6F85" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C8FA1" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#ACB0BE" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="#EFF1F5" />
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#CCD0DA" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#CCD0DA" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8C8FA1" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#8C8FA1" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="#CCD0DA" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#DCE0E8" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#8C8FA1" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#CCD0DA" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="#CCD0DA" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#6C6F85" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#8C8FA1" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#6C6F85" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#6C6F85" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#4C4F69" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#E6E9EF" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#BCC0CC" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#9CA0B0" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#7C7F93" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#8C8FA1" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#4C4F69" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#4C4F69" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#6C6F85" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#CCD0DA" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
