<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design "Windows Vista / 7 (Aero)": the glossy gradients of Windows 7's own controls. Light only. The accent colour
         (selection, the main button) is made by ThemeService; what is the same for every accent colour is in here. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5B5B5B" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7F7F7F" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="AppHeadingBrush" Color="#1E395B" />

    <!-- Surfaces: the dialog grey, an Explorer-like navigation pane, a white page with panels on it -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="#F0F0F0" />
    <LinearGradientBrush x:Key="AppNavPaneBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFCFF" Offset="0" />
        <GradientStop Color="#E3EAF5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="#7DA2CE" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F3F6FB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#BFCBDB" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#D5DDE8" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8E8F8F" />
    <LinearGradientBrush x:Key="SubtleFillColorSecondaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EEF4FC" Offset="0" />
        <GradientStop Color="#D5E4F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlFillColorSecondaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F7FB" Offset="0" />
        <GradientStop Color="#E3EAF3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#979797" />

    <!-- Buttons: grey glass, blue glass under the pointer, a bright inner frame -->
    <LinearGradientBrush x:Key="CtlButtonBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F2F2" Offset="0" />
        <GradientStop Color="#EBEBEB" Offset="0.5" />
        <GradientStop Color="#DDDDDD" Offset="0.5" />
        <GradientStop Color="#CFCFCF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlButtonBorder" Color="#707070" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="#CCFFFFFF" />
    <LinearGradientBrush x:Key="CtlButtonHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF6FD" Offset="0" />
        <GradientStop Color="#D9F0FC" Offset="0.5" />
        <GradientStop Color="#BEE6FD" Offset="0.5" />
        <GradientStop Color="#A7D9F5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#3C7FB1" />
    <LinearGradientBrush x:Key="CtlButtonPressedBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E5F4FC" Offset="0" />
        <GradientStop Color="#C4E5F6" Offset="0.5" />
        <GradientStop Color="#98D1EF" Offset="0.5" />
        <GradientStop Color="#68B3DB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="#2C628B" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#3399FF" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#F4F4F4" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="#ADB2B5" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#F4F4F4" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#ABADB3" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#5794BF" />

    <!-- Tick boxes, radio buttons: dark-blue mark on a glass square -->
    <LinearGradientBrush x:Key="CtlGlyphBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCDCDC" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtlGlyphHoverBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BEE6FD" Offset="0" />
        <GradientStop Color="#F4FBFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#8E8F8F" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#3C7FB1" />
    <LinearGradientBrush x:Key="CtlCheckedBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DCDCDC" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlCheckedBorder" Color="#8E8F8F" />
    <SolidColorBrush x:Key="CtlCheckMarkBrush" Color="#1E395B" />
    <SolidColorBrush x:Key="CtlRadioDotBrush" Color="#1E395B" />

    <!-- Lists: hovered rows get a pale blue sheen; the selected ones (accent) are made by ThemeService -->
    <LinearGradientBrush x:Key="CtlListHoverBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F6FAFE" Offset="0" />
        <GradientStop Color="#E3EEFA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="#B8D6FB" />

    <!-- Progress: the green bar of Windows 7 -->
    <LinearGradientBrush x:Key="CtlProgressTrack" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6E6E6" Offset="0" />
        <GradientStop Color="#F3F3F3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlProgressBorder" Color="#BCBCBC" />
    <LinearGradientBrush x:Key="CtlProgressFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7BEF8E" Offset="0" />
        <GradientStop Color="#2ACB45" Offset="0.5" />
        <GradientStop Color="#1FB83A" Offset="0.5" />
        <GradientStop Color="#4FDD66" Offset="1" />
    </LinearGradientBrush>

    <!-- Scroll bars: grey track, glass thumb and arrow buttons -->
    <SolidColorBrush x:Key="CtlScrollTrack" Color="#EDEDED" />
    <LinearGradientBrush x:Key="CtlScrollThumb" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F7F7" Offset="0" />
        <GradientStop Color="#D5D5D5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="#979797" />
    <LinearGradientBrush x:Key="CtlScrollThumbHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EAF6FD" Offset="0" />
        <GradientStop Color="#A7D9F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtlScrollThumbPressed" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C4E5F6" Offset="0" />
        <GradientStop Color="#68B3DB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtlScrollArrowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7F7F7" Offset="0" />
        <GradientStop Color="#DADADA" Offset="1" />
    </LinearGradientBrush>

    <!-- Slider -->
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#E7EAEA" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="#9DA1A5" />
    <SolidColorBrush x:Key="CtlSliderFill" Color="#A7D9F5" />
    <LinearGradientBrush x:Key="CtlSliderThumb" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F2F2" Offset="0" />
        <GradientStop Color="#CFCFCF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="#707070" />
    <LinearGradientBrush x:Key="CtlSliderThumbHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF6FD" Offset="0" />
        <GradientStop Color="#A7D9F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CtlSliderThumbPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C4E5F6" Offset="0" />
        <GradientStop Color="#68B3DB" Offset="1" />
    </LinearGradientBrush>

    <!-- Table header: a pale glass strip -->
    <LinearGradientBrush x:Key="CtlHeaderBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#EFF3F9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#D5DDE8" />

    <!-- Tabs: a raised tab with rounded top corners -->
    <LinearGradientBrush x:Key="AppTabSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F3F6FB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AppTabSelectedBorderBrush" Color="#8E9BB0" />
    <LinearGradientBrush x:Key="AppTabHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF6FD" Offset="0" />
        <GradientStop Color="#D9F0FC" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
