@page "/manual-data"
@using System.ComponentModel
@inherits ViewModelComponent<ManualDataViewModel>

<BrandedTitle Title="@Vm.Title" />

<section class="page">
    <div class="progress @(Vm.IsBusy ? "on" : "")" role="progressbar" aria-hidden="@(!Vm.IsBusy)"></div>

    <header class="page-head">
        <div>
            <h1>@Vm.Title</h1>
        </div>
    </header>

    <PageGate Page="Vm">
        <ErrorBanner Message="@Vm.ErrorMessage" OnRetry="RetryLoading" />

        @if (Vm.IsWrongSource)
        {
            <div class="banner" role="status">
                <Icon Name="alert" />
                <span>@Strings.Manual_WrongSource</span>
            </div>
        }

        @if (Vm.HasNotice)
        {
            <div class="banner ok" role="status">
                <Icon Name="check" />
                <span>@Vm.NoticeText</span>
            </div>
        }

        @* The group: pick one, or add / rename / delete. *@
        <article class="card card-form">
            <div class="field-with-action">
                @if (Vm.HasGroups)
                {
                    <label class="field">
                        <span>@Strings.Manual_Group</span>
                        <select value="@Vm.SelectedGroupId" @onchange="OnGroupChosen">
                            @foreach (var group in Vm.Groups)
                            {
                                <option value="@group.Id">@group.Name</option>
                            }
                        </select>
                    </label>
                }
                <div class="form-actions">
                    <button type="button" class="btn" disabled="@(!Vm.NameForm.BeginNewGroupCommand.CanExecute(null))" @onclick="() => Vm.NameForm.BeginNewGroupCommand.Execute(null)">
                        <Icon Name="plus" /><span>@Strings.Manual_NewGroup</span>
                    </button>
                    @if (Vm.HasGroup)
                    {
                        <button type="button" class="btn ghost" disabled="@(!Vm.NameForm.BeginRenameGroupCommand.CanExecute(null))" @onclick="() => Vm.NameForm.BeginRenameGroupCommand.Execute(null)">
                            <Icon Name="edit" /><span>@Strings.Manual_RenameGroup</span>
                        </button>
                        <button type="button" class="btn ghost danger" disabled="@(!Vm.AskDeleteGroupCommand.CanExecute(null))" @onclick="() => Vm.AskDeleteGroupCommand.Execute(null)">
                            <Icon Name="trash" /><span>@Strings.Manual_DeleteGroup</span>
                        </button>
                    }
                </div>
            </div>
        </article>

        @if (Vm.NameForm.IsOpen)
        {
            <article class="card card-form">
                <form @onsubmit="() => Vm.NameForm.SaveCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
                    <h3>@Vm.NameForm.Title</h3>
                    <label class="field">
                        <span>@Strings.Manual_Name</span>
                        <input type="text" maxlength="@ManualDataRules.MaxNameLength" autocomplete="off" @bind="Vm.NameForm.Text" @bind:event="oninput" />
                        @if (Vm.NameForm.Problem is { } nameProblem)
                        {
                            <p class="field-error" role="alert">@nameProblem</p>
                        }
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="btn" disabled="@(!Vm.NameForm.SaveCommand.CanExecute(null))">@Strings.Manual_Save</button>
                        <button type="button" class="btn ghost" @onclick="() => Vm.NameForm.CancelCommand.Execute(null)">@Strings.Manual_Cancel</button>
                    </div>
                </form>
            </article>
        }

        @if (Vm.IsConfirming)
        {
            <div class="confirm" role="alertdialog" aria-label="@Vm.ConfirmText">
                <span>@Vm.ConfirmText</span>
                <button type="button" class="btn danger" @onclick="() => Vm.ConfirmCommand.ExecuteAsync(null)"><span>@Strings.Manual_ConfirmYes</span></button>
                <button type="button" class="btn ghost" @onclick="() => Vm.CancelConfirmCommand.Execute(null)"><span>@Strings.Manual_Cancel</span></button>
            </div>
        }

        @if (Vm.HasNoGroups)
        {
            <p class="empty">@Strings.Manual_NoGroups</p>
        }

        @if (Vm.HasGroup)
        {
            <div class="tabs" role="tablist">
                <button type="button" role="tab" class="tab @(Vm.IsMembersSection ? "on" : "")" aria-selected="@Vm.IsMembersSection" @onclick="() => Vm.SectionIndex = ManualDataViewModel.MembersSection">@Strings.Manual_TabMembers</button>
                <button type="button" role="tab" class="tab @(Vm.IsSubGroupsSection ? "on" : "")" aria-selected="@Vm.IsSubGroupsSection" @onclick="() => Vm.SectionIndex = ManualDataViewModel.SubGroupsSection">@Strings.Manual_TabSubGroups</button>
                <button type="button" role="tab" class="tab @(Vm.IsEventsSection ? "on" : "")" aria-selected="@Vm.IsEventsSection" @onclick="() => Vm.SectionIndex = ManualDataViewModel.EventsSection">@Strings.Manual_TabEvents</button>
            </div>
        }

        @* --- Members ------------------------------------------------------------------------------------ *@
        @if (Vm.HasGroup && Vm.IsMembersSection)
        {
            <div class="form-actions">
                <button type="button" class="btn" disabled="@(!Vm.MemberEditor.BeginNewCommand.CanExecute(null))" @onclick="() => Vm.MemberEditor.BeginNewCommand.Execute(null)">
                    <Icon Name="plus" /><span>@Strings.Manual_NewMember</span>
                </button>
            </div>

            @if (Vm.MemberEditor.IsOpen)
            {
                <article class="card card-form">
                    <form @onsubmit="() => Vm.MemberEditor.SaveCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
                        <h3>@Vm.MemberEditor.Title</h3>
                        <div class="grid two">
                            <label class="field">
                                <span>@Strings.Manual_Name</span>
                                <input type="text" maxlength="@ManualDataRules.MaxNameLength" autocomplete="off" @bind="Vm.MemberEditor.Name" @bind:event="oninput" />
                                @if (Vm.MemberEditor.NameProblem is { } memberNameProblem)
                                {
                                    <p class="field-error" role="alert">@memberNameProblem</p>
                                }
                            </label>

                            <div class="field">
                                <label for="manual-birth">@Strings.Manual_BirthDate</label>
                                <div class="color-row">
                                    <input id="manual-birth" type="date" min="@MemberRules.EarliestBirth.ToString("yyyy-MM-dd")" @bind="Vm.MemberEditor.BirthDate" @bind:event="onchange" />
                                    <button type="button" class="btn ghost" disabled="@(!Vm.MemberEditor.ClearBirthDateCommand.CanExecute(null))"
                                            @onclick="() => Vm.MemberEditor.ClearBirthDateCommand.Execute(null)">@Strings.Manual_ClearBirth</button>
                                </div>
                                @if (Vm.MemberEditor.BirthProblem is { } birthProblem)
                                {
                                    <p class="field-error" role="alert">@birthProblem</p>
                                }
                            </div>
                        </div>

                        <fieldset class="field">
                            <legend>@Strings.Manual_SubGroups</legend>
                            @if (Vm.MemberEditor.HasSubGroupChoices)
                            {
                                <div class="check-scroll">
                                    @foreach (var choice in Vm.MemberEditor.SubGroups)
                                    {
                                        <label class="check">
                                            <input type="checkbox" checked="@choice.IsSelected" @onchange="e => choice.IsSelected = (bool)(e.Value ?? false)" />
                                            <span>@choice.Name</span>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <small>@Strings.Manual_NoSubGroupsHint</small>
                            }
                        </fieldset>

                        <div class="form-actions">
                            <button type="submit" class="btn" disabled="@(!Vm.MemberEditor.SaveCommand.CanExecute(null))">@Strings.Manual_Save</button>
                            <button type="button" class="btn ghost" @onclick="() => Vm.MemberEditor.CancelCommand.Execute(null)">@Strings.Manual_Cancel</button>
                        </div>
                    </form>
                </article>
            }

            @if (Vm.MembersEmpty)
            {
                <p class="empty">@Strings.Manual_NoMembers</p>
            }
            else if (Vm.Members.Count > 0)
            {
                <article class="card results">
                    <div class="table-wrap">
                        <table class="data">
                            <thead>
                                <tr>
                                    <th>@Strings.Manual_ColName</th>
                                    <th>@Strings.Manual_ColBirth</th>
                                    <th>@Strings.Manual_ColSubGroups</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Vm.Members)
                                {
                                    <tr @key="member.Id">
                                        <td>@member.Name</td>
                                        <td>@member.BirthText</td>
                                        <td>@member.SubGroupsText</td>
                                        <td class="row-actions">
                                            <button type="button" class="btn ghost" aria-label="@($"{Strings.Manual_Edit}: {member.Name}")"
                                                    disabled="@(!Vm.MemberEditor.BeginEditCommand.CanExecute(member))" @onclick="() => Vm.MemberEditor.BeginEditCommand.Execute(member)">
                                                <Icon Name="edit" /><span>@Strings.Manual_Edit</span>
                                            </button>
                                            <button type="button" class="btn ghost danger" aria-label="@($"{Strings.Manual_Delete}: {member.Name}")"
                                                    disabled="@(!Vm.AskDeleteMemberCommand.CanExecute(member))" @onclick="() => Vm.AskDeleteMemberCommand.Execute(member)">
                                                <Icon Name="trash" /><span>@Strings.Manual_Delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
        }

        @* --- Subgroups ---------------------------------------------------------------------------------- *@
        @if (Vm.HasGroup && Vm.IsSubGroupsSection)
        {
            <div class="form-actions">
                <button type="button" class="btn" disabled="@(!Vm.NameForm.BeginNewSubGroupCommand.CanExecute(null))" @onclick="() => Vm.NameForm.BeginNewSubGroupCommand.Execute(null)">
                    <Icon Name="plus" /><span>@Strings.Manual_NewSubGroup</span>
                </button>
            </div>

            @if (Vm.SubGroupsEmpty)
            {
                <p class="empty">@Strings.Manual_NoSubGroups</p>
            }
            else if (Vm.SubGroups.Count > 0)
            {
                <article class="card results">
                    <div class="table-wrap">
                        <table class="data">
                            <thead>
                                <tr>
                                    <th>@Strings.Manual_ColName</th>
                                    <th>@Strings.Manual_ColMembers</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subGroup in Vm.SubGroups)
                                {
                                    <tr @key="subGroup.Id">
                                        <td>@subGroup.Name</td>
                                        <td>@subGroup.CountText</td>
                                        <td class="row-actions">
                                            <button type="button" class="btn ghost" aria-label="@($"{Strings.Manual_Rename}: {subGroup.Name}")"
                                                    disabled="@(!Vm.NameForm.BeginRenameSubGroupCommand.CanExecute(subGroup))" @onclick="() => Vm.NameForm.BeginRenameSubGroupCommand.Execute(subGroup)">
                                                <Icon Name="edit" /><span>@Strings.Manual_Rename</span>
                                            </button>
                                            <button type="button" class="btn ghost danger" aria-label="@($"{Strings.Manual_Delete}: {subGroup.Name}")"
                                                    disabled="@(!Vm.AskDeleteSubGroupCommand.CanExecute(subGroup))" @onclick="() => Vm.AskDeleteSubGroupCommand.Execute(subGroup)">
                                                <Icon Name="trash" /><span>@Strings.Manual_Delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
        }

        @* --- Events ------------------------------------------------------------------------------------- *@
        @if (Vm.HasGroup && Vm.IsEventsSection)
        {
            <div class="form-actions">
                <button type="button" class="btn" disabled="@(!Vm.EventEditor.BeginNewCommand.CanExecute(null))" @onclick="() => Vm.EventEditor.BeginNewCommand.ExecuteAsync(null)">
                    <Icon Name="plus" /><span>@Strings.Manual_NewEvent</span>
                </button>
            </div>

            @if (Vm.EventEditor.IsOpen)
            {
                <article class="card card-form">
                    <form @onsubmit="() => Vm.EventEditor.SaveCommand.ExecuteAsync(null)" @onsubmit:preventDefault>
                        <h3>@Vm.EventEditor.Title</h3>
                        <label class="field">
                            <span>@Strings.Manual_Name</span>
                            <input type="text" maxlength="@ManualDataRules.MaxNameLength" autocomplete="off" @bind="Vm.EventEditor.Name" @bind:event="oninput" />
                            @if (Vm.EventEditor.NameProblem is { } eventNameProblem)
                            {
                                <p class="field-error" role="alert">@eventNameProblem</p>
                            }
                        </label>

                        <div class="grid two">
                            <div class="field">
                                <label for="manual-start">@Strings.Manual_Start</label>
                                <div class="color-row">
                                    <input id="manual-start" type="date" @bind="Vm.EventEditor.StartDate" @bind:event="onchange" />
                                    <input type="time" aria-label="@Strings.Manual_TimeHint" value="@Vm.EventEditor.StartTime" @oninput="e => Vm.EventEditor.StartTime = e.Value?.ToString() ?? string.Empty" />
                                </div>
                            </div>
                            <div class="field">
                                <label for="manual-end">@Strings.Manual_End</label>
                                <div class="color-row">
                                    <input id="manual-end" type="date" @bind="Vm.EventEditor.EndDate" @bind:event="onchange" />
                                    <input type="time" aria-label="@Strings.Manual_TimeHint" value="@Vm.EventEditor.EndTime" @oninput="e => Vm.EventEditor.EndTime = e.Value?.ToString() ?? string.Empty" />
                                </div>
                            </div>
                        </div>
                        @if (Vm.EventEditor.TimeProblem is { } timeProblem)
                        {
                            <p class="field-error" role="alert">@timeProblem</p>
                        }

                        <label class="check">
                            <input type="checkbox" checked="@Vm.EventEditor.Cancelled" @onchange="e => Vm.EventEditor.Cancelled = (bool)(e.Value ?? false)" />
                            <span>@Strings.Manual_Cancelled</span>
                        </label>

                        <h4>@Strings.Manual_Invitations</h4>
                        @if (Vm.EventEditor.HasInvitees)
                        {
                            <div class="form-actions">
                                <button type="button" class="btn ghost" disabled="@(!Vm.EventEditor.InviteAllCommand.CanExecute(null))" @onclick="() => Vm.EventEditor.InviteAllCommand.Execute(null)">@Strings.Manual_InviteAll</button>
                                <button type="button" class="btn ghost" disabled="@(!Vm.EventEditor.InviteNoneCommand.CanExecute(null))" @onclick="() => Vm.EventEditor.InviteNoneCommand.Execute(null)">@Strings.Manual_InviteNone</button>
                                <button type="button" class="btn ghost" disabled="@(!Vm.EventEditor.AcceptAllCommand.CanExecute(null))" @onclick="() => Vm.EventEditor.AcceptAllCommand.Execute(null)">@Strings.Manual_AcceptAll</button>
                            </div>

                            <div class="table-wrap">
                                <table class="data">
                                    <thead>
                                        <tr>
                                            <th>@Strings.Manual_ColInvited</th>
                                            <th>@Strings.Manual_ColName</th>
                                            <th>@Strings.Manual_ColAnswer</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var invitee in Vm.EventEditor.Invitees)
                                        {
                                            <tr @key="invitee.MemberId">
                                                <td><input type="checkbox" aria-label="@invitee.Name" checked="@invitee.IsInvited" @onchange="e => invitee.IsInvited = (bool)(e.Value ?? false)" /></td>
                                                <td>@invitee.Name</td>
                                                <td>
                                                    <select aria-label="@($"{Strings.Manual_ColAnswer}: {invitee.Name}")" disabled="@(!invitee.IsInvited)" value="@invitee.Answer.Value"
                                                            @onchange="e => invitee.Answer = Vm.EventEditor.RsvpOptions.First(o => o.Value == e.Value?.ToString())">
                                                        @foreach (var option in Vm.EventEditor.RsvpOptions)
                                                        {
                                                            <option value="@option.Value">@option.Text</option>
                                                        }
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <small>@Strings.Manual_NoMembersToInvite</small>
                        }

                        <div class="form-actions">
                            <button type="submit" class="btn" disabled="@(!Vm.EventEditor.SaveCommand.CanExecute(null))">@Strings.Manual_Save</button>
                            <button type="button" class="btn ghost" @onclick="() => Vm.EventEditor.CancelCommand.Execute(null)">@Strings.Manual_Cancel</button>
                        </div>
                    </form>
                </article>
            }

            @if (Vm.EventsEmpty)
            {
                <p class="empty">@Strings.Manual_NoEvents</p>
            }
            else if (Vm.Events.Count > 0)
            {
                <article class="card results">
                    <div class="table-wrap">
                        <table class="data">
                            <thead>
                                <tr>
                                    <th>@Strings.Manual_ColName</th>
                                    <th>@Strings.Manual_ColStart</th>
                                    <th>@Strings.Manual_Invitations</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var manualEvent in Vm.Events)
                                {
                                    <tr @key="manualEvent.Id">
                                        <td>@manualEvent.Name</td>
                                        <td>@manualEvent.StartText</td>
                                        <td>@manualEvent.InvitedText</td>
                                        <td class="row-actions">
                                            <button type="button" class="btn ghost" aria-label="@($"{Strings.Manual_Edit}: {manualEvent.Event.Name}")"
                                                    disabled="@(!Vm.EventEditor.BeginEditCommand.CanExecute(manualEvent))" @onclick="() => Vm.EventEditor.BeginEditCommand.ExecuteAsync(manualEvent)">
                                                <Icon Name="edit" /><span>@Strings.Manual_Edit</span>
                                            </button>
                                            <button type="button" class="btn ghost danger" aria-label="@($"{Strings.Manual_Delete}: {manualEvent.Event.Name}")"
                                                    disabled="@(!Vm.AskDeleteEventCommand.CanExecute(manualEvent))" @onclick="() => Vm.AskDeleteEventCommand.Execute(manualEvent)">
                                                <Icon Name="trash" /><span>@Strings.Manual_Delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
        }
    </PageGate>
</section>

@code {
    protected override IEnumerable<INotifyPropertyChanged> ObservedSources => [Vm, Vm.NameForm, Vm.MemberEditor, Vm.EventEditor];

    protected override async Task OnInitializedAsync() => await Vm.ActivateAsync();

    private void OnGroupChosen(ChangeEventArgs e) =>
        Vm.SelectedGroup = Vm.Groups.FirstOrDefault(g => g.Id == e.Value?.ToString()) ?? Vm.SelectedGroup;

    /// <summary>Only when the groups could not be loaded: a failed change is not helped by loading again.</summary>
    private EventCallback RetryLoading =>
        Vm.HasLoaded ? default : EventCallback.Factory.Create(this, () => Vm.RetryCommand.ExecuteAsync(null));

    public override void Dispose()
    {
        Vm.Deactivate();
        base.Dispose();
    }
}
