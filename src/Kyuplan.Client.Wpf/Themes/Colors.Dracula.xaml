<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Dracula" (dark only): same keys as Colors.Win10.Light.xaml. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F8F8F2" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5C8D9" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8F94B3" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6B6F8A" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="#282A36" />
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#21222C" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#2B2D3B" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1E1F29" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2F3140" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#44475A" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#44475A" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#6272A4" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#3A3D4F" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#44475A" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2D3B" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#6272A4" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#44475A" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="#44475A" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#50536B" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#6272A4" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#5D6180" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="#44475A" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#C5C8D9" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#2F3140" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#1E1F29" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#1E1F29" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#2F3140" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#6272A4" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#C5C8D9" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#C5C8D9" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#F8F8F2" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#3A3D4F" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#44475A" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#565A75" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#6D7290" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#8890B5" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#6272A4" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#F8F8F2" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#F8F8F2" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#C5C8D9" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#44475A" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
