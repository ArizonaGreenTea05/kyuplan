<UserControl x:Class="Kyuplan.Client.WpfApp.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Kyuplan.Contracts;assembly=Kyuplan.Contracts"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,6,24,32">

                <!-- Title + the roles of the user, one chip each (or that there is none) -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{loc:Loc Account_Rights}" Style="{StaticResource FieldLabelText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" />
                        <ItemsControl ItemsSource="{Binding RoleNames}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PillBorder}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource PillBorder}"
                                Visibility="{Binding RoleNames.Count, Converter={StaticResource ZeroToVisible}}">
                            <TextBlock Text="{Binding RoleText}" />
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc Account_Lede}" Style="{StaticResource LedeText}" />
                    </StackPanel>
                </DockPanel>

                <!-- What went wrong / what was achieved -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource NoticeBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <ctl:ResponsiveGrid MinItemWidth="360" Gap="14" Margin="0,20,0,0">

                <!-- Names: the user name, what other users see, and more names to sign in with (one per line) -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Account_NamesTitle}" Style="{StaticResource SectionTitleText}" />

                        <TextBlock Text="{loc:Loc Account_UserNameTitle}" Style="{StaticResource FieldLabelText}" />
                        <TextBox MaxLength="{x:Static contracts:AccountRules.MaxUserNameLength}"
                                 AutomationProperties.Name="{loc:Loc Account_UserNameTitle}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding UserNameProblem}" Style="{StaticResource ProblemText}"
                                   Visibility="{Binding UserNameProblem, Converter={StaticResource StringToVisibility}}" />

                        <TextBlock Text="{loc:Loc Account_DisplayName}" Style="{StaticResource FieldLabelText}" Margin="0,14,0,4" />
                        <TextBox MaxLength="{x:Static contracts:AccountRules.MaxDisplayNameLength}"
                                 AutomationProperties.Name="{loc:Loc Account_DisplayName}"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding DisplayNameProblem}" Style="{StaticResource ProblemText}"
                                   Visibility="{Binding DisplayNameProblem, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{loc:Loc Account_DisplayNameHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="{loc:Loc Account_Aliases}" Style="{StaticResource FieldLabelText}" Margin="0,14,0,4" />
                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{loc:Loc Account_Aliases}"
                                 Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding AliasesProblem}" Style="{StaticResource ProblemText}" TextWrapping="Wrap"
                                   Visibility="{Binding AliasesProblem, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding AliasesHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <Button Content="{loc:Loc Account_SaveProfile}" Command="{Binding SaveProfileCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Password. A PasswordBox cannot be bound: the code-behind copies it over (and empties it again after a change). -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Account_PasswordTitle}" Style="{StaticResource SectionTitleText}" />

                        <TextBlock Text="{loc:Loc Account_CurrentPassword}" Style="{StaticResource FieldLabelText}" />
                        <ctl:RevealPasswordBox x:Name="CurrentBox" MaxLength="{x:Static contracts:AccountRules.MaxPasswordLength}"
                                     PasswordChanged="OnCurrentChanged" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Loc Account_NewPassword}" Style="{StaticResource FieldLabelText}" />
                        <ctl:RevealPasswordBox x:Name="NewBox" MaxLength="{x:Static contracts:AccountRules.MaxPasswordLength}"
                                     PasswordChanged="OnNewChanged" />
                        <TextBlock Text="{Binding PasswordProblem}" Style="{StaticResource ProblemText}"
                                   Visibility="{Binding PasswordProblem, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource MutedText}" Margin="0,4,0,12" />

                        <TextBlock Text="{loc:Loc Account_ConfirmPassword}" Style="{StaticResource FieldLabelText}" />
                        <ctl:RevealPasswordBox x:Name="ConfirmBox" MaxLength="{x:Static contracts:AccountRules.MaxPasswordLength}"
                                     PasswordChanged="OnConfirmChanged" />
                        <TextBlock Text="{Binding ConfirmProblem}" Style="{StaticResource ProblemText}"
                                   Visibility="{Binding ConfirmProblem, Converter={StaticResource StringToVisibility}}" />

                        <Button Content="{loc:Loc Account_ChangePassword}" Command="{Binding ChangePasswordCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                </ctl:ResponsiveGrid>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
