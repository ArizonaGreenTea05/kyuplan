<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design "Windows 10", light: the greys of Windows 10's own apps. The accent colour is not in here (ThemeService makes it).
         Colors.Win10.Dark.xaml has the same keys. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5E5E5E" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#A0A0A0" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E1E1E1" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DADADA" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#CCCCCC" />

    <!-- Buttons: grey, a dark frame appears under the pointer -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#CCCCCC" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#D6D6D6" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#7A7A7A" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#A6A6A6" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#4D4D4D" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#EDEDED" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#CCCCCC" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#7A7A7A" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#333333" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#000000" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#D6D6D6" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#C2C2C2" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#A0A0A0" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#6E6E6E" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#CCCCCC" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#333333" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#555555" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#777777" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#DADADA" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
