<UserControl x:Class="Kyuplan.Client.WpfApp.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             x:Name="Root" IsTabStop="False" Focusable="True">

    <!-- A PasswordBox with a button that shows the password as plain text (a TextBox takes the same place). -->
    <Grid>
        <PasswordBox x:Name="Hidden" Padding="11,5,34,6" PasswordChanged="OnHiddenChanged"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}" />
        <TextBox x:Name="Shown" Visibility="Collapsed" Padding="11,5,34,6" TextChanged="OnShownChanged"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}" />

        <ToggleButton x:Name="Toggle" HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="24" Margin="0,0,4,0"
                      Padding="0" Focusable="False" Background="Transparent" BorderThickness="0"
                      AutomationProperties.Name="{loc:Loc Password_Show}" Checked="OnToggled" Unchecked="OnToggled">
            <TextBlock x:Name="Glyph" Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE7B3;" />
        </ToggleButton>
    </Grid>
</UserControl>
