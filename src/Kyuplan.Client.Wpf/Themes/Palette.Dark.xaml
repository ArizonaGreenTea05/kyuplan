<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark counterpart of Palette.Light.xaml: same keys, tuned for dark surfaces. -->

    <SolidColorBrush x:Key="DataYesBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="DataYesTextBrush" Color="#99EBFF" />
    <SolidColorBrush x:Key="DataYesWashBrush" Color="#0F2A3D" />

    <SolidColorBrush x:Key="DataOpenBrush" Color="#E8B04B" />
    <SolidColorBrush x:Key="DataOpenTextBrush" Color="#F2B84B" />
    <SolidColorBrush x:Key="DataOpenWashBrush" Color="#3A2D12" />

    <SolidColorBrush x:Key="DataRiskTextBrush" Color="#FF8F85" />
    <SolidColorBrush x:Key="DataRiskWashBrush" Color="#3B1815" />

    <SolidColorBrush x:Key="DataNoBrush" Color="#6E6E6A" />

    <SolidColorBrush x:Key="DataTrackBrush" Color="#444441" />
</ResourceDictionary>
