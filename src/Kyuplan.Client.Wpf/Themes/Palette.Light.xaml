<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- What the colours of the data mean. Windows' own Fluent theme draws everything else (in the accent colour of the
         instance, see ThemeService), so this only holds colours that carry meaning. The same keys are in Palette.Dark.xaml.
         The accent colour means "attended / meets the bar"; amber is "open / below". -->

    <!-- Attended, qualified: ThemeService overrides these three with the accent colour; the values here (Windows' default
         blue) only show where nobody has run it. -->
    <SolidColorBrush x:Key="DataYesBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="DataYesTextBrush" Color="#003E92" />
    <SolidColorBrush x:Key="DataYesWashBrush" Color="#E5F0FA" />

    <!-- No answer yet, below the bar, demo marker -->
    <SolidColorBrush x:Key="DataOpenBrush" Color="#E0A100" />
    <SolidColorBrush x:Key="DataOpenTextBrush" Color="#965800" />
    <SolidColorBrush x:Key="DataOpenWashBrush" Color="#FBEFD2" />

    <!-- At risk, errors -->
    <SolidColorBrush x:Key="DataRiskTextBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DataRiskWashBrush" Color="#FBE4E1" />

    <!-- Declined: a communicated absence, neutral grey. -->
    <SolidColorBrush x:Key="DataNoBrush" Color="#B5B5B1" />

    <!-- The empty part of a bar -->
    <SolidColorBrush x:Key="DataTrackBrush" Color="#E2E2DE" />
</ResourceDictionary>
