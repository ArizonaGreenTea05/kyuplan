<UserControl x:Class="Kyuplan.Client.WpfApp.Controls.TagForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Kyuplan.Contracts;assembly=Kyuplan.Contracts"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             IsVisibleChanged="OnIsVisibleChanged">

    <!-- The fields that make or change a tag: its name and the event it is about. Its DataContext is a TagEditorViewModel. Used on the
         tags page and inside the comment being written. Enter in the name saves. -->
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" />

        <StackPanel HorizontalAlignment="Left" Width="520">
            <TextBlock Text="{loc:Loc Tags_FormName}" Style="{StaticResource FieldLabelText}" />
            <TextBox x:Name="NameBox" MaxLength="{x:Static contracts:TagRules.MaxNameLength}"
                     AutomationProperties.Name="{loc:Loc Tags_FormName}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding NameProblem}" Style="{StaticResource ProblemText}"
                       Visibility="{Binding NameProblem, Converter={StaticResource StringToVisibility}}" />

            <TextBlock Text="{loc:Loc Tags_FormEvent}" Style="{StaticResource FieldLabelText}" Margin="0,16,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ClearEventCommand}" Content="{loc:Loc Tags_ClearEvent}"
                        Margin="8,0,0,0" VerticalAlignment="Top" />
                <ctl:EventPicker Options="{Binding EventOptions}" SelectedId="{Binding EventId, Mode=TwoWay}"
                                 AutomationProperties.Name="{loc:Loc Tags_FormEvent}" />
            </DockPanel>
            <TextBlock Text="{loc:Loc Tags_FormEventHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ProblemText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:Loc Tags_Save}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="Text" Value="{loc:Loc Tags_Create}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button Command="{Binding CancelCommand}" Content="{loc:Loc Tags_Cancel}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
