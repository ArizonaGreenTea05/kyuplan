<UserControl x:Class="Kyuplan.Client.WpfApp.Views.SyncStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization">

    <UserControl.Resources>
        <!-- A run that failed stands out. -->
        <Style x:Key="RunText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Succeeded}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DataRiskTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,6,24,32">

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{loc:Loc SyncStatus_Lede}" Style="{StaticResource LedeText}" />
            </StackPanel>

            <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                       Text="{loc:Loc Page_NotAllowed}"
                       Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">

                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <StackPanel Visibility="{Binding HasLoaded, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IntervalText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastSuccessText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastFailureText}" Foreground="{DynamicResource DataRiskTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsFailing, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding RetryCommand}" Content="{loc:Loc SyncStatus_Refresh}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc SyncStatus_RecentTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Loc SyncStatus_RecentEmpty}" Style="{StaticResource MutedText}"
                                       Visibility="{Binding HasRuns, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Runs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource RunText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
