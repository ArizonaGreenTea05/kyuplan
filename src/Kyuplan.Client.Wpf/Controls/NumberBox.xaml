<UserControl x:Class="Kyuplan.Client.WpfApp.Controls.NumberBox"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 x:Name="Root" IsTabStop="False">

    <!-- A whole-number field with spin buttons inside it, like WinUI's NumberBox: type a value, press Up/Down,
         use the mouse wheel, or hold a button. The box is the stock Fluent TextBox; its text is written by the code-behind
         (not bound), which pulls a typed number back to the limits before it reaches the bound value. -->
    <Grid>
        <TextBox x:Name="Box" VerticalContentAlignment="Center" Padding="11,5,60,6"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                 PreviewKeyDown="OnKeyDown" MouseWheel="OnMouseWheel" LostFocus="OnLostFocus" TextChanged="OnTextChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
            <RepeatButton Width="26" Height="24" Padding="0" Focusable="False" Click="OnUp"
                          Style="{StaticResource DefaultRepeatButtonStyle}" Background="Transparent" BorderThickness="0">
                <TextBlock Style="{StaticResource GlyphText}" FontSize="9" Text="&#xE70E;" />
            </RepeatButton>
            <RepeatButton Width="26" Height="24" Padding="0" Focusable="False" Click="OnDown"
                          Style="{StaticResource DefaultRepeatButtonStyle}" Background="Transparent" BorderThickness="0">
                <TextBlock Style="{StaticResource GlyphText}" FontSize="9" Text="&#xE70D;" />
            </RepeatButton>
        </StackPanel>
    </Grid>
</UserControl>
