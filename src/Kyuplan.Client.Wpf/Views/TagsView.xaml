<UserControl x:Class="Kyuplan.Client.WpfApp.Views.TagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared">

    <UserControl.Resources>
        <!-- The page's data context for the columns of the grid, which are not in the visual tree. -->
        <ctl:BindingProxy x:Key="Page" Data="{Binding}" />

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NumberHeader" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The list is the page's main content, so it only shows once there is something in it: before that comes the
             invitation to create the first tag, or the reason the tags could not be loaded. -->
        <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tags.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24,6,24,32">

                <!-- Title + new tag -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Command="{Binding BeginCreateCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE710;" />
                            <TextBlock Text="{loc:Loc Tags_New}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc Tags_Lede}" Style="{StaticResource LedeText}" />
                    </StackPanel>
                </DockPanel>

                <!-- What went wrong / what was achieved. Trying again only makes sense while there is no list. -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" Content="{loc:Loc Shell_TryAgain}" Margin="12,0,0,0"
                                Visibility="{Binding Tags.Count, Converter={StaticResource ZeroToVisible}}" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource NoticeBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <!-- The form: a new tag, or the one being edited -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                        Visibility="{Binding Editor.IsOpen, Converter={StaticResource BoolToVisibility}}">
                    <ctl:TagForm DataContext="{Binding Editor}" />
                </Border>

                <!-- Nothing is deleted before this question is answered -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding ConfirmDeleteCommand}" Content="{loc:Loc Tags_ConfirmYes}" />
                            <Button Command="{Binding CancelDeleteCommand}" Content="{loc:Loc Tags_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- The tags, by name -->
                <Border Style="{StaticResource ListCard}" Margin="0,16,0,0">
                    <DataGrid ItemsSource="{Binding Tags}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" MinRowHeight="52" FontSize="13"
                              ColumnHeaderStyle="{StaticResource GridHeader}" SelectionMode="Single"
                              KeyboardNavigation.TabNavigation="Continue"
                              Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="{loc:Loc Nav_Tags}" PreviewMouseWheel="OnGridMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Tags_ColTag}" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE8EC;" Margin="0,1,8,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:Loc Tags_ColEvent}" Width="2*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <!-- A tag about an event: its name, and when it takes place. Without one: "No event", muted. -->
                                            <StackPanel Visibility="{Binding HasEvent, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding EventName}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding EventWhenText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding EventText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasEvent, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Binding="{Binding CommentCount, Mode=OneWay}" Width="110" MinWidth="100" ElementStyle="{StaticResource NumberCell}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Loc Tags_ColComments}" Style="{StaticResource NumberHeader}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Wide enough for both buttons in both languages: an automatic width is not worked out again when the language changes.
                                 Somebody who may not change tags has no use for the column. -->
                            <DataGridTemplateColumn Width="200" MinWidth="190"
                                                    Visibility="{Binding Data.CanEdit, Source={StaticResource Page}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Button Content="{loc:Loc Tags_Edit}"
                                                    Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Loc Tags_Delete}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Somebody who may not see the tags gets here only by a mistake of the navigation: the API would refuse them anyway. -->
        <TextBlock Style="{StaticResource NotAllowedText}" Text="{loc:Loc Page_NotAllowed}"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{loc:Loc Shell_Loading}" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
