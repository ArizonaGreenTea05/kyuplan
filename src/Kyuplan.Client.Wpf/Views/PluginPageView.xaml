<UserControl x:Class="Kyuplan.Client.WpfApp.Views.PluginPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization">

    <!-- A page a plugin added: the plugin describes it in JSON, PluginItemsView draws it. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,6,24,32">

            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />

            <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                       Text="{loc:Loc Page_NotAllowed}"
                       Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

            <StackPanel Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{loc:Loc Shell_Loading}" Height="3" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />

                <!-- An action that asks "really?" waits for the answer; nothing is called before it. -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,12,0,0"
                        Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding ConfirmCommand}" Content="{loc:Loc Plugin_Confirm}" AutomationProperties.Name="{loc:Loc Plugin_Confirm}" />
                            <Button Command="{Binding CancelConfirmationCommand}" Content="{loc:Loc Plugin_Cancel}" AutomationProperties.Name="{loc:Loc Plugin_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ctl:PluginItemsView Items="{Binding Items}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
