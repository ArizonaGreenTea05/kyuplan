<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design "Native WPF": no theme at all (Application.ThemeMode = None). The controls are the ones WPF has always had, drawn
         by the Windows desktop (Aero2 on Windows 8 and later), and every colour is a system colour, so the program follows the
         user's Windows colour scheme and High Contrast. This file only gives the app's own styles the names they ask for. -->

    <!-- ===== The brushes Styles.xaml and the windows read, as system colours ===== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />

    <!-- ===== Design tokens (see Design.Fluent.xaml) ===== -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" />
    <Visibility x:Key="AppNavIndicatorVisibility">Collapsed</Visibility>
    <CornerRadius x:Key="AppContentCornerRadius">0</CornerRadius>
    <Thickness x:Key="AppContentBorderThickness">1,0,0,0</Thickness>
    <CornerRadius x:Key="AppPillCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="AppSwatchCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="AppTabCornerRadius">0</CornerRadius>
    <Thickness x:Key="AppTabBorderThickness">0,0,0,3</Thickness>
    <Thickness x:Key="AppTabPadding">12,6,12,4</Thickness>
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />

    <FontFamily x:Key="SymbolThemeFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The grey dialog colour of the desktop behind everything (ThemeService puts it on the windows). -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />

    <!-- The stock table draws its lines black. -->
    <Style TargetType="DataGrid">
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="DefaultControlFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1"
                               StrokeDashArray="1 2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== The names the app's styles base theirs on: the plain WPF controls ===== -->
    <Style x:Key="DefaultButtonStyle" TargetType="Button" />
    <Style x:Key="DefaultToggleButtonStyle" TargetType="ToggleButton" />
    <Style x:Key="DefaultRepeatButtonStyle" TargetType="RepeatButton" />
    <Style x:Key="DefaultListBoxItemStyle" TargetType="ListBoxItem" />
    <Style x:Key="DefaultDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader" />
    <Style x:Key="DefaultDataGridCellStyle" TargetType="DataGridCell" />

    <!-- The main button of a form: the desktop's "default button", a bold label in a frame of the selection colour. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <!-- ===== Type ramp: the system font, sizes in steps ===== -->
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
</ResourceDictionary>
