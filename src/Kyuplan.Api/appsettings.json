{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "Path": "logs/kyuplan-.log"
    }
  },
  "AllowedHosts": "*",
  "Plugins": {
    "InstallDefaults": true,
    "Defaults": [ "https://github.com/ArizonaGreenTea05/kyuplan.plugins.spond" ]
  },
  "Spond": {
    "UseDemoData": false,
    "AccountCooldown": "06:00:00",
    "LoginLifetime": "06:00:00",
    "CacheDuration": "00:30:00"
  },
  "Statistics": {
    "TimeZone": "Europe/Berlin",
    "DefaultMinAttendancePercent": 60,
    "DefaultMinInvitedEvents": 3,
    "DashboardDays": 90,
    "UpcomingDays": 14
  },
  "Database": {
    "ConnectionString": "Data Source=data/kyuplan.db"
  },
  "DefaultData": {
    "Enabled": true
  },
  "Sync": {
    "Enabled": true,
    "Interval": "01:00:00"
  },
  "Accounts": {
    "ConnectionString": "Data Source=data/accounts.db"
  },
  "Api": {
    "ApiKey": "",
    "AllowedOrigins": []
  },
  "Branding": {
    "ProductName": "kyuplan",
    "OrganizationName": "My Club",
    "AccentColor": "#C93A26",
    "Logo": "branding/logo-black.svg",
    "LogoOnDark": "branding/logo-white.svg",
    "Icon": "branding/favicon.svg"
  }
}
