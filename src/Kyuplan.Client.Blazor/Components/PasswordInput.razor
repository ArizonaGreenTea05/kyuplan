@* A password box with a button that shows the password as plain text. Other attributes (maxlength, disabled, autocomplete...) go to the input. *@
<span class="password-input">
    <input type="@(_visible ? "text" : "password")" value="@Value" @oninput="OnInput" @attributes="Attributes" />
    <button type="button" class="password-toggle" @onclick="Toggle"
            title="@Label" aria-label="@Label" aria-pressed="@_visible.ToString().ToLowerInvariant()">
        <Icon Name="@(_visible ? "eye-off" : "eye")" Size="16" />
    </button>
</span>

@code {
    private bool _visible;

    [Parameter] public string Value { get; set; } = "";

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private string Label => _visible ? Strings.Password_Hide : Strings.Password_Show;

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private void Toggle() => _visible = !_visible;
}
