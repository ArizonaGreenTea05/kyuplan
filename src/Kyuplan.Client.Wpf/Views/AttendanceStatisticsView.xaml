<UserControl x:Class="Kyuplan.Client.WpfApp.Views.AttendanceStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared"
             xmlns:converters="clr-namespace:Kyuplan.Client.WpfApp.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Right-aligned plain text cell. The Fluent cell has no padding of its own, so the inset is set here. -->
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Subgroups: a muted list that wraps within its column. -->
        <Style x:Key="SubGroupCell" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- The attendance cell fills the whole row, so the required-attendance line can run from edge to edge. -->
        <Style x:Key="BleedCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24,6,24,20" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title + the question the filters currently ask -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding FilterSummary}" Style="{StaticResource LedeText}" />
                <TextBlock Text="{Binding FilterError}" Foreground="{DynamicResource DataRiskTextBrush}" FontWeight="SemiBold" Margin="0,6,0,0"
                           Visibility="{Binding FilterError, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource BannerBorder}" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            Command="{Binding RefreshCommand}" 
                            Content="{loc:Loc Shell_TryAgain}" 
                            Margin="12,0,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Filters (collapsible: the table below is what matters once they are set) -->
            <Expander Grid.Row="2" IsExpanded="True" Margin="0,14,0,0" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{loc:Loc Stats_Filters}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Expander.Header>
                    <TextBlock Text="{loc:Loc Stats_Filters}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Expander.Header>
                <StackPanel>
                    <!-- Default filters: the time span as two events, who, and how much attendance is required -->
                    <ctl:ResponsiveGrid MinItemWidth="220" Gap="16" Margin="0,4,0,2">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Stats_FromEvent}" Style="{StaticResource FieldLabelText}" />
                            <ctl:EventPicker Options="{Binding EventOptions}" SelectedId="{Binding FromEventId}"
                                             AutomationProperties.Name="{loc:Loc Stats_FromEvent}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Stats_ToEvent}" Style="{StaticResource FieldLabelText}" />
                            <ctl:EventPicker Options="{Binding EventOptions}" SelectedId="{Binding ToEventId}"
                                             AutomationProperties.Name="{loc:Loc Stats_ToEvent}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Stats_Members}" Style="{StaticResource FieldLabelText}" />
                            <ctl:SubGroupPicker Options="{Binding SubGroupOptions}" Summary="{Binding SubGroupSummary}"
                                                IsEveryone="{Binding IsEveryoneSelected, Mode=OneWay}"
                                                ClearCommand="{Binding ClearSubGroupsCommand}"
                                                AutomationProperties.Name="{loc:Loc Stats_Members}" />
                        </StackPanel>

                        <StackPanel ToolTip="{loc:Loc Stats_MinAttendanceHint}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource DataYesTextBrush}" FontWeight="Bold"
                                           Text="{Binding ThresholdText}" />
                                <TextBlock Text="{loc:Loc Stats_MinAttendance}" Style="{StaticResource FieldLabelText}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="10"
                                    IsSnapToTickEnabled="True" Value="{Binding MinAttendancePercent}"
                                    AutomationProperties.Name="{loc:Loc Stats_MinAttendance}" />
                        </StackPanel>
                        <StackPanel ToolTip="{loc:Loc Stats_MinStarsHint}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource DataYesTextBrush}" FontWeight="Bold"
                                           Text="{Binding MinAverageStarsText}" />
                                <TextBlock Text="{loc:Loc Stats_MinStars}" Style="{StaticResource FieldLabelText}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
                                    IsSnapToTickEnabled="True" Value="{Binding MinAverageStars}"
                                    AutomationProperties.Name="{loc:Loc Stats_MinStars}" />
                        </StackPanel>
                        <StackPanel ToolTip="{loc:Loc Stats_MinInvitedHint}">
                            <TextBlock Text="{loc:Loc Stats_MinInvited}" Style="{StaticResource FieldLabelText}" />
                            <ctl:NumberBox Minimum="1" Maximum="200" Value="{Binding MinInvitedEvents}"
                                           AutomationProperties.Name="{loc:Loc Stats_MinInvited}"  />
                        </StackPanel>
                        <Button VerticalAlignment="Bottom" HorizontalAlignment="Left" Command="{Binding ResetFiltersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE7A7;" />
                                <TextBlock Text="{loc:Loc Stats_Reset}" />
                            </StackPanel>
                        </Button>
                    </ctl:ResponsiveGrid>

                    <!-- Saved filters: named filters kept on the server, one set per exam. They belong to the exams: without seeing those, there is no such part. -->
                    <StackPanel DataContext="{Binding SavedFilters}" Margin="0,12,0,0" AutomationProperties.Name="{loc:Loc Saved_Title}"
                                Visibility="{Binding CanUse, Converter={StaticResource BoolToVisibility}}">
                        <ctl:ResponsiveGrid MinItemWidth="220" Gap="16">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Saved_Pick}" Style="{StaticResource FieldLabelText}" />
                                <Grid>
                                    <ComboBox ItemsSource="{Binding FilterChoices}" SelectedItem="{Binding SelectedFilter}"
                                              IsEnabled="{Binding HasFilters}" HorizontalAlignment="Stretch" MinHeight="56"
                                              AutomationProperties.Name="{loc:Loc Saved_Pick}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SavedFilterOption}">
                                                <StackPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ExamText, Mode=OneWay}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- A ComboBox has no placeholder: this is drawn over it while nothing is chosen. -->
                                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,40,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{loc:Loc Saved_PickPrompt}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding SelectedFilter}" Value="{x:Null}" />
                                                            <Condition Binding="{Binding HasFilters}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,40,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{loc:Loc Saved_PickEmpty}"
                                               Visibility="{Binding HasFilters, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <!-- Every button is only there for somebody who may use it. -->
                                <Button Command="{Binding BeginSaveCommand}" Content="{loc:Loc Saved_SaveAs}"
                                        Visibility="{Binding CanSaveFilter, Converter={StaticResource BoolToVisibility}}" />
                                <Button Command="{Binding ReloadSelectedCommand}" Content="{loc:Loc Saved_Reload}" ToolTip="{loc:Loc Saved_ReloadTip}" Margin="8,0,0,0" />
                                <Button Command="{Binding AskUpdateCommand}" Content="{loc:Loc Saved_Update}" ToolTip="{loc:Loc Saved_UpdateTip}" Margin="8,0,0,0"
                                        Visibility="{Binding CanChangeFilters, Converter={StaticResource BoolToVisibility}}" />
                                <Button Command="{Binding AskDeleteFilterCommand}" Content="{loc:Loc Saved_Delete}" Margin="8,0,0,0"
                                        Visibility="{Binding CanChangeFilters, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </ctl:ResponsiveGrid>

                        <!-- Saving the filters as they are now, for an exam: while the form is open, and only for somebody who may save filters -->
                        <Border Padding="14" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSaving}" Value="True" />
                                                <Condition Binding="{Binding CanSaveFilter}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <ctl:ResponsiveGrid MinItemWidth="220" Gap="16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Saved_FilterName}" Style="{StaticResource FieldLabelText}" />
                                        <ctl:HintedTextBox Text="{Binding NewFilterName, UpdateSourceTrigger=PropertyChanged}"
                                                           AutomationProperties.Name="{loc:Loc Saved_FilterName}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Saved_Exam}" Style="{StaticResource FieldLabelText}" />
                                        <ComboBox ItemsSource="{Binding ExamChoices}" SelectedItem="{Binding SelectedExam}"
                                                  DisplayMemberPath="Label" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:Loc Saved_Exam}" />
                                    </StackPanel>
                                </ctl:ResponsiveGrid>
                                <ctl:ResponsiveGrid MinItemWidth="220" Gap="16" Margin="0,12,0,0"
                                                    Visibility="{Binding IsNewExam, Converter={StaticResource BoolToVisibility}}">
                                    <!-- An exam is a Spond event: a new one is made by choosing the event -->
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Saved_ExamEvent}" Style="{StaticResource FieldLabelText}" />
                                        <ctl:EventPicker Options="{Binding EventOptions}" SelectedId="{Binding NewExamEventId}"
                                                         AutomationProperties.Name="{loc:Loc Saved_ExamEvent}" />
                                    </StackPanel>
                                </ctl:ResponsiveGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Command="{Binding SaveCommand}" Content="{loc:Loc Saved_Save}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Command="{Binding CancelSaveCommand}" Content="{loc:Loc Saved_Cancel}" Margin="8,0,0,0" />
                                    <!-- Only for an exam that exists, and for somebody who may delete exams -->
                                    <Button Command="{Binding AskDeleteExamCommand}" Content="{loc:Loc Saved_DeleteExam}" Margin="8,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsNewExam}" Value="False" />
                                                            <Condition Binding="{Binding CanMakeExams}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nothing is replaced or deleted before this question is answered -->
                        <Border Style="{StaticResource BannerBorder}" Margin="0,12,0,0"
                                Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button Command="{Binding ConfirmPendingCommand}" Content="{Binding ConfirmYesText}" />
                                    <Button Command="{Binding CancelPendingCommand}" Content="{loc:Loc Saved_Cancel}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DataRiskTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <!-- Advanced filters: the time span as dates, and event names -->
                    <Expander IsExpanded="{Binding ShowAdvanced, Mode=TwoWay}" Margin="0,12,0,0" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{loc:Loc Stats_Advanced}">
                        <Expander.Header>
                            <TextBlock Text="{loc:Loc Stats_Advanced}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{Binding SpanHint}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                            <ctl:ResponsiveGrid MinItemWidth="188" Gap="16" Margin="0,0,0,2">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Stats_From}" Style="{StaticResource FieldLabelText}" />
                                    <DatePicker x:Name="FromPicker" AutomationProperties.Name="{loc:Loc Stats_From}" SelectedDateFormat="Short" SelectedDate="{Binding From, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Stats_To}" Style="{StaticResource FieldLabelText}" />
                                    <DatePicker x:Name="ToPicker" AutomationProperties.Name="{loc:Loc Stats_To}" SelectedDateFormat="Short" SelectedDate="{Binding To, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Stats_QuickRanges}" Style="{StaticResource FieldLabelText}" />
                                    <UniformGrid Columns="2">
                                        <Button Content="{loc:Loc Range_3Months}" Command="{Binding SetRangeCommand}" CommandParameter="3m" Margin="0,0,3,3" HorizontalAlignment="Stretch" Padding="6,4" />
                                        <Button Content="{loc:Loc Range_6Months}" Command="{Binding SetRangeCommand}" CommandParameter="6m" Margin="3,0,0,3" HorizontalAlignment="Stretch" Padding="6,4" />
                                        <Button Content="{loc:Loc Range_12Months}" Command="{Binding SetRangeCommand}" CommandParameter="12m" Margin="0,3,3,0" HorizontalAlignment="Stretch" Padding="6,4" />
                                        <Button Content="{loc:Loc Range_ThisYear}" Command="{Binding SetRangeCommand}" CommandParameter="year" Margin="3,3,0,0" HorizontalAlignment="Stretch" Padding="6,4" />
                                    </UniformGrid>
                                </StackPanel>
                                <StackPanel ToolTip="{loc:Loc Stats_NameContainsHint}">
                                    <TextBlock Text="{loc:Loc Stats_NameContains}" Style="{StaticResource FieldLabelText}" />
                                    <ctl:HintedTextBox Hint="{loc:Loc Stats_NameContainsPlaceholder}" AutomationProperties.Name="{loc:Loc Stats_NameContains}"
                                                       Text="{Binding EventNameContains, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel ToolTip="{loc:Loc Stats_NameExcludesHint}">
                                    <TextBlock Text="{loc:Loc Stats_NameExcludes}" Style="{StaticResource FieldLabelText}" />
                                    <ctl:HintedTextBox Hint="{loc:Loc Stats_NameExcludesPlaceholder}" AutomationProperties.Name="{loc:Loc Stats_NameExcludes}"
                                                       Text="{Binding EventNameExcludes, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </ctl:ResponsiveGrid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>

            <!-- Key figures -->
            <ItemsControl Grid.Row="3" Margin="0,14,0,0" ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiCompactTemplate}"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:ResponsiveGrid MinItemWidth="120" Gap="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Results -->
            <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0" Margin="0,14,0,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource UnderlineTab}">

                    <!-- Members -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Tab_Members}" />
                                <TextBlock Text="{Binding VisibleMembers.Count}" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="16,12">
                                <ctl:HintedTextBox DockPanel.Dock="Right" Width="250" Glyph="&#xE721;"
                                                   Hint="{loc:Loc Stats_FindMember}"
                                                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                   AutomationProperties.Name="{loc:Loc Stats_FindMember}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{loc:Loc Stats_Show}">
                                    <RadioButton Content="{loc:Loc Stats_Everyone}" GroupName="status" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static vm:MemberStatusFilter.All}}" />
                                    <RadioButton Content="{loc:Loc Status_Qualified}" GroupName="status" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static vm:MemberStatusFilter.Qualified}}" />
                                    <RadioButton Content="{loc:Loc Filter_Below}" GroupName="status" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static vm:MemberStatusFilter.BelowThreshold}}" />
                                    <RadioButton Content="{loc:Loc Status_TooFew}" GroupName="status" Style="{StaticResource SegmentButton}"
                                                 IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBoolean}, ConverterParameter={x:Static vm:MemberStatusFilter.InsufficientData}}" />
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="MembersGrid" Grid.Row="1" ItemsSource="{Binding VisibleMembers}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="56" FontSize="13"
                                      ColumnHeaderStyle="{StaticResource GridHeader}"
                                      SelectionMode="Single" Background="Transparent" BorderThickness="0"
                                      AutomationProperties.Name="{loc:Loc Caption_Members}" Sorting="OnMembersSorting">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{loc:Loc Col_Member}" SortMemberPath="Name" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"
                                                           VerticalAlignment="Center" Margin="8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="{loc:Loc Col_SubGroups}" SortMemberPath="SubGroups" Binding="{Binding SubGroupsText, Mode=OneWay}"
                                                        Width="130" ElementStyle="{StaticResource SubGroupCell}" />

                                    <DataGridTemplateColumn Header="{loc:Loc Col_Status}" Width="116">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusPill}" ToolTip="{Binding StatusTip}" Margin="8,0">
                                                    <TextBlock Text="{Binding StatusText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Attendance: a bar per member and the required attendance as one line through the column. -->
                                    <DataGridTemplateColumn SortMemberPath="AttendanceRate" Width="216" CellStyle="{StaticResource BleedCell}">
                                        <DataGridTemplateColumn.Header>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Col_Attendance}" />
                                                <TextBlock Style="{StaticResource MutedText}" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           Text="{Binding DataContext.RequiredText, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           Margin="{Binding DataContext.ThresholdFraction, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource FractionToMargin}, ConverterParameter='8,120'}" />
                                            </StackPanel>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" MinWidth="46" />
                                                    </Grid.ColumnDefinitions>
                                                    <ctl:RateBar Grid.Column="1" Fraction="{Binding AttendanceFraction}" Style="{StaticResource MemberRateBar}"
                                                                 BarCenter="21"
                                                                 Threshold="{Binding DataContext.ThresholdFraction, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                 AutomationProperties.Name="{Binding AttendanceAriaText}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding AttendanceText}" FontWeight="SemiBold"
                                                               VerticalAlignment="Top" Margin="0,11,0,0" TextAlignment="Right" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding AttendedEventsText}" Style="{StaticResource MutedText}"
                                                               VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="{loc:Loc Col_Answered}" SortMemberPath="ResponseRate" Binding="{Binding ResponseRateText, Mode=OneWay}"
                                                        Width="90" ElementStyle="{StaticResource NumberCell}" />

                                    <DataGridTextColumn Header="{loc:Loc Col_Streak}" SortMemberPath="CurrentStreak" Binding="{Binding StreakText, Mode=OneWay}"
                                                        Width="106" ElementStyle="{StaticResource NumberCell}" />

                                    <DataGridTemplateColumn Header="{loc:Loc Col_LastAttended}" SortMemberPath="DaysSinceLastAttended" Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding LastAttendedDateText}" />
                                                    <TextBlock Text="{Binding LastAttendedAgoText}" Style="{StaticResource MutedText}"
                                                               Visibility="{Binding LastAttendedAgoText, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="{loc:Loc Col_PerWeek}" SortMemberPath="SessionsPerWeek" Binding="{Binding SessionsPerWeekText, Mode=OneWay}"
                                                        Width="88" ElementStyle="{StaticResource NumberCell}" />

                                    <DataGridTemplateColumn Header="{loc:Loc Rating_StarsHeader}" SortMemberPath="Stars" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StarsText}" ToolTip="{Binding StarsTip}" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="8,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="160">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{loc:Loc Col_Form}" ToolTip="{loc:Loc Col_FormTip}" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                    <ItemsControl ItemsSource="{Binding RecentMarks}" Style="{StaticResource MarkList}" />
                                                    <TextBlock Text="{Binding TrendGlyph}" Style="{StaticResource TrendText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{loc:Loc Col_Engagement}" SortMemberPath="EngagementScore" Width="*" MinWidth="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource LevelPill}" ToolTip="{loc:Loc Col_EngagementTip}" Margin="8,0">
                                                    <TextBlock>
                                                        <Run Text="{Binding EngagementScore, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding LevelText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="2" Margin="16,10">
                                <Border Style="{StaticResource LegendSquare}" Background="{DynamicResource DataYesBrush}" />
                                <TextBlock Text="{loc:Loc Legend_Attended}" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                                <Border Style="{StaticResource LegendSquare}" Background="{DynamicResource DataNoBrush}" />
                                <TextBlock Text="{loc:Loc Legend_Declined}" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                                <Border Style="{StaticResource LegendSquare}" Background="{DynamicResource DataOpenBrush}" />
                                <TextBlock Text="{loc:Loc Legend_NoAnswer}" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                                <Border Style="{StaticResource LegendSquare}" Background="Transparent"
                                        BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="1.5" />
                                <TextBlock Text="{loc:Loc Legend_WaitingList}" Style="{StaticResource MutedText}" Margin="0,0,14,0" />
                                <TextBlock Text="{loc:Loc Legend_RequiredLine}" Style="{StaticResource MutedText}" />
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <!-- Insights -->
                    <TabItem Header="{loc:Loc Tab_Insights}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ctl:ResponsiveGrid MinItemWidth="420" Gap="36" Margin="22,22">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Chart_DistributionTitle}" Style="{StaticResource SectionTitleText}" />
                                    <ctl:ColumnChart Bars="{Binding Distribution}" Style="{StaticResource ThresholdColumnChart}"
                                                     AutomationProperties.Name="{loc:Loc Chart_DistributionAria}" />
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="{loc:Loc Chart_DistributionNote}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Chart_TrendTitle}" Style="{StaticResource SectionTitleText}" />
                                    <ctl:ColumnChart Bars="{Binding Trend}" Style="{StaticResource AttendanceColumnChart}"
                                                     AutomationProperties.Name="{loc:Loc Chart_TrendAria}" />
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="{loc:Loc Chart_TrendNote}" />
                                </StackPanel>
                            </ctl:ResponsiveGrid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Events -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Tab_Events}" />
                                <TextBlock Text="{Binding Events.Count}" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </TabItem.Header>
                        <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" RowHeight="52" FontSize="13" SelectionMode="Single" RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  Background="Transparent" BorderThickness="0" AutomationProperties.Name="{loc:Loc Caption_Events}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Col_Event}" Binding="{Binding Name, Mode=OneWay}" Width="220">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="8,0" />
                                            <Setter Property="FontSize" Value="13" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Loc Col_Date}" Binding="{Binding StartText, Mode=OneWay}" Width="190"
                                                    ElementStyle="{StaticResource TextCell}" />
                                <DataGridTemplateColumn Header="{loc:Loc Col_Attendance}" Width="*" MinWidth="240">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ctl:RateBar Fraction="{Binding AttendanceFraction}" Style="{StaticResource PlainRateBar}"
                                                                 AutomationProperties.Name="{Binding AttendanceText}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AttendanceText}" FontWeight="SemiBold"
                                                               Margin="10,0,0,0" MinWidth="54" TextAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{Binding InvitedCameText}" Style="{StaticResource MutedText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Col_Declined}" Binding="{Binding DeclinedText, Mode=OneWay}" Width="100" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="{loc:Loc Col_NoAnswer}" Binding="{Binding UnansweredText, Mode=OneWay}" Width="120" ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="{loc:Loc Rating_StarsHeader}" Binding="{Binding StarsText, Mode=OneWay}" Width="90" ElementStyle="{StaticResource NumberCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>

            <TextBlock Grid.Row="3" Grid.RowSpan="2" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                       Text="{loc:Loc Stats_NoResults}"
                       Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

            <ProgressBar Grid.RowSpan="5" IsIndeterminate="True" AutomationProperties.Name="{loc:Loc Shell_Loading}" Height="3" VerticalAlignment="Top" Margin="-24,-6,-24,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Somebody who may not use the page gets here only by a mistake of the navigation: the API would refuse them anyway. -->
        <TextBlock Style="{StaticResource NotAllowedText}" Text="{loc:Loc Page_NotAllowed}"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
