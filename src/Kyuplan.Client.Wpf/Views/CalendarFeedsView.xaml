<UserControl x:Class="Kyuplan.Client.WpfApp.Views.CalendarFeedsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Kyuplan.Contracts;assembly=Kyuplan.Contracts"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared">

    <UserControl.Resources>
        <!-- One subgroup or member to tick. -->
        <DataTemplate x:Key="OptionTemplate" DataType="{x:Type vm:FeedOption}">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}" Margin="0,2" />
        </DataTemplate>

        <!-- A subgroup to tick, with the word it puts in front of titles once ticked. -->
        <DataTemplate x:Key="SubGroupTemplate" DataType="{x:Type vm:FeedOption}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}" MinWidth="130" VerticalAlignment="Center" />
                <TextBox Width="110" MaxLength="{x:Static contracts:CalendarFeedRules.MaxLabelLength}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="{loc:Loc CalendarFeeds_SubGroupLabel}" AutomationProperties.Name="{loc:Loc CalendarFeeds_SubGroupLabel}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SourceTemplate" DataType="{x:Type vm:FeedSourceEditor}">
            <Border Style="{StaticResource BannerBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="200" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc CalendarFeeds_FieldKind}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{x:Static vm:FeedSourceEditor.KindChoices}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                      SelectedValue="{Binding Kind, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldKind}" />
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc CalendarFeeds_FieldGroup}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding GroupId, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldGroup}" />
                        </StackPanel>
                        <StackPanel Width="200">
                            <TextBlock Text="{loc:Loc CalendarFeeds_FieldLabel}" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                            <TextBox MaxLength="{x:Static contracts:CalendarFeedRules.MaxLabelLength}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldLabel}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Width="300" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc CalendarFeeds_FieldSubGroups}" Style="{StaticResource FieldLabelText}" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SubGroups}" ItemTemplate="{StaticResource SubGroupTemplate}"
                                              AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldSubGroups}" />
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Width="300">
                            <TextBlock Text="{loc:Loc CalendarFeeds_FieldMembers}" Style="{StaticResource FieldLabelText}" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource OptionTemplate}"
                                              AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldMembers}" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc CalendarFeeds_PeopleHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEvents, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc CalendarFeeds_FieldInvitation}" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                        <ComboBox Width="420" HorizontalAlignment="Left" ItemsSource="{x:Static vm:FeedSourceEditor.InvitationChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Value" SelectedValue="{Binding Invitation, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldInvitation}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel Width="300" Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc CalendarFeeds_FieldContains}" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                                <TextBox MaxLength="{x:Static contracts:CalendarFeedRules.MaxTermsLength}" Text="{Binding NameContains, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldContains}" />
                            </StackPanel>
                            <StackPanel Width="300">
                                <TextBlock Text="{loc:Loc CalendarFeeds_FieldExcludes}" Style="{StaticResource FieldLabelText}" TextWrapping="Wrap" />
                                <TextBox MaxLength="{x:Static contracts:CalendarFeedRules.MaxTermsLength}" Text="{Binding NameExcludes, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc CalendarFeeds_FieldExcludes}" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding OnlyExams, Mode=TwoWay}" Content="{loc:Loc CalendarFeeds_FieldOnlyExams}" />
                        <CheckBox Margin="0,4,0,0" IsChecked="{Binding IncludeCancelled, Mode=TwoWay}" Content="{loc:Loc CalendarFeeds_FieldCancelled}" />
                    </StackPanel>

                    <Button Margin="0,12,0,0" HorizontalAlignment="Left" Content="{loc:Loc CalendarFeeds_RemoveSource}"
                            Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24,6,24,32">

                <!-- Title + new calendar -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Command="{Binding BeginCreateCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE710;" />
                            <TextBlock Text="{loc:Loc CalendarFeeds_New}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc CalendarFeeds_Lede}" Style="{StaticResource LedeText}" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" Content="{loc:Loc Shell_TryAgain}" Margin="12,0,0,0"
                                Visibility="{Binding Feeds.Count, Converter={StaticResource ZeroToVisible}}" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource NoticeBorder}" Margin="0,16,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <!-- The form: a new calendar, or the one being edited -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Visibility="{Binding Editor.IsOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Editor}">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" />

                        <StackPanel HorizontalAlignment="Left" Width="520">
                            <TextBlock Text="{loc:Loc CalendarFeeds_FormName}" Style="{StaticResource FieldLabelText}" />
                            <TextBox MaxLength="{x:Static contracts:CalendarFeedRules.MaxNameLength}" AutomationProperties.Name="{loc:Loc CalendarFeeds_FormName}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding NameProblem}" Style="{StaticResource ProblemText}"
                                       Visibility="{Binding NameProblem, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SourceTemplate}" />

                        <Button HorizontalAlignment="Left" Command="{Binding AddSourceCommand}" Content="{loc:Loc CalendarFeeds_AddSource}" />

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ProblemText}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc CalendarFeeds_Save}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc CalendarFeeds_Create}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding CancelCommand}" Content="{loc:Loc CalendarFeeds_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nothing is deleted or given a new address before this question is answered -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding ConfirmCommand}" Content="{loc:Loc CalendarFeeds_ConfirmYes}" />
                            <Button Command="{Binding CancelConfirmCommand}" Content="{loc:Loc CalendarFeeds_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- The calendars, each with the address to give to calendar apps -->
                <TextBlock Text="{loc:Loc CalendarFeeds_AddressHint}" Style="{StaticResource MutedText}" Margin="0,16,0,0" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Feeds}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CalendarFeedRow}">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding SourcesText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <TextBox Margin="0,8,0,0" IsReadOnly="True" Text="{Binding Url, Mode=OneWay}"
                                             AutomationProperties.Name="{loc:Loc CalendarFeeds_ColAddress}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{loc:Loc CalendarFeeds_Edit}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Content="{loc:Loc CalendarFeeds_NewAddress}" Margin="8,0,0,0" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.AskRegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Content="{loc:Loc CalendarFeeds_Delete}" Margin="8,0,0,0" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                           Text="{loc:Loc CalendarFeeds_Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Style="{StaticResource NotAllowedText}" Text="{loc:Loc Page_NotAllowed}"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

        <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{loc:Loc Shell_Loading}" Height="3" VerticalAlignment="Top" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
