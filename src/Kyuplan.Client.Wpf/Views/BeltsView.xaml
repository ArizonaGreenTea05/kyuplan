<UserControl x:Class="Kyuplan.Client.WpfApp.Views.BeltsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Kyuplan.Contracts;assembly=Kyuplan.Contracts"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared">

    <UserControl.Resources>
        <!-- The page's data context for the columns of the grid, which are not in the visual tree. -->
        <ctl:BindingProxy x:Key="Page" Data="{Binding}" />

        <!-- One line per belt a member may come from, so a row is as tall as its lines. -->
        <Style x:Key="TextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NumberHeader" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- The list is the page's main content, so it only shows once there is something in it: before that comes the
             invitation to create the first belt, or the reason the belts could not be loaded. -->
        <Style x:Key="ListCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Belts.Count}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The presets of the view model as swatches; Tag is the command that takes a colour (the item's own context is the colour). -->
        <Style x:Key="ColorPresetList" TargetType="ItemsControl" BasedOn="{StaticResource SwatchList}">
            <Setter Property="ItemsSource" Value="{x:Static vm:BeltsViewModel.ColorPresets}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24,6,24,32">

                <!-- Title + new belt -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Command="{Binding BeginCreateCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE710;" />
                            <TextBlock Text="{loc:Loc Belts_New}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc Belts_Lede}" Style="{StaticResource LedeText}" />
                    </StackPanel>
                </DockPanel>

                <!-- What went wrong / what was achieved. Trying again only makes sense while there is no list. -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" Content="{loc:Loc Shell_TryAgain}" Margin="12,0,0,0"
                                Visibility="{Binding Belts.Count, Converter={StaticResource ZeroToVisible}}" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource NoticeBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <!-- The form: a new belt, or the one being edited -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                        Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitleText}" />

                        <StackPanel HorizontalAlignment="Left" Width="480">
                            <TextBlock Text="{loc:Loc Belts_FormName}" Style="{StaticResource FieldLabelText}" />
                            <TextBox MaxLength="{x:Static contracts:BeltRules.MaxNameLength}"
                                     AutomationProperties.Name="{loc:Loc Belts_FormName}"
                                     Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding NameProblem}" Style="{StaticResource ProblemText}"
                                       Visibility="{Binding NameProblem, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>

                        <!-- Colours: typed as #RRGGBB or picked from the swatches -->
                        <ctl:ResponsiveGrid MinItemWidth="340" Gap="24" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Belts_FormColor}" Style="{StaticResource FieldLabelText}" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource PreviewSwatch}"
                                            Background="{Binding PrimaryPreview, Converter={StaticResource HexToBrush}}" />
                                    <TextBox VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Loc Belts_FormColor}"
                                             Text="{Binding FormPrimaryColor, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="{Binding PrimaryColorProblem}" Style="{StaticResource ProblemText}"
                                           Visibility="{Binding PrimaryColorProblem, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{loc:Loc Belts_ColorHint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                                <ItemsControl Style="{StaticResource ColorPresetList}" Tag="{Binding PickPrimaryColorCommand}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="{loc:Loc Belts_FormStripe}" Style="{StaticResource FieldLabelText}" />
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Style="{StaticResource PreviewSwatch}"
                                            Background="{Binding SecondaryPreview, Converter={StaticResource HexToBrush}}" />
                                    <Button DockPanel.Dock="Right" Command="{Binding ClearSecondaryColorCommand}" Content="{loc:Loc Belts_NoStripe}"
                                            Margin="8,0,0,0" />
                                    <TextBox VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Loc Belts_FormStripe}"
                                             Text="{Binding FormSecondaryColor, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="{Binding SecondaryColorProblem}" Style="{StaticResource ProblemText}"
                                           Visibility="{Binding SecondaryColorProblem, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="{loc:Loc Belts_ColorHint}" Style="{StaticResource MutedText}" Margin="0,4,0,8" />
                                <ItemsControl Style="{StaticResource ColorPresetList}" Tag="{Binding PickSecondaryColorCommand}" />
                            </StackPanel>
                        </ctl:ResponsiveGrid>

                        <!-- The belts one of which has to be held before this one. What else is required (age, waiting time) depends on
                             the belt a member comes from, so a ticked belt brings its own two numbers. -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{loc:Loc Belts_FormPrerequisites}" Style="{StaticResource FieldLabelText}" />
                            <TextBlock Text="{loc:Loc Belts_FormPrerequisitesHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding PrerequisiteOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BeltPrerequisiteOption}">
                                        <DockPanel Margin="0,0,0,10">
                                            <!-- Once ticked, the boxes appear next to the belt: the tick box moves down to be level with them, not with their captions. -->
                                            <Border DockPanel.Dock="Left" Width="200" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Margin" Value="0,6,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Margin" Value="0,21,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ctl:BeltSwatch Color="{Binding Color}" Width="28" Height="12" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                            <WrapPanel Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Width="200" Margin="0,0,16,0">
                                                    <TextBlock Text="{loc:Loc Belts_ColMinAge}" Style="{StaticResource FieldLabelText}" />
                                                    <ctl:NumberBox Minimum="0" Maximum="{x:Static contracts:BeltRules.MaxMinAgeYears}" Value="{Binding MinAgeYears}"
                                                                   CommitWhileTyping="True">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                                <Binding Path="Name" />
                                                                <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[Belts_ColMinAge]" />
                                                            </MultiBinding>
                                                        </AutomationProperties.Name>
                                                    </ctl:NumberBox>
                                                    <TextBlock Text="{Binding MinAgeProblem}" Style="{StaticResource ProblemText}"
                                                               Visibility="{Binding MinAgeProblem, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                                <StackPanel Width="200">
                                                    <TextBlock Text="{loc:Loc Belts_ColMinWait}" Style="{StaticResource FieldLabelText}" />
                                                    <ctl:NumberBox Minimum="0" Maximum="{x:Static contracts:BeltRules.MaxMinWaitMonths}" Value="{Binding MinWaitMonths}"
                                                                   CommitWhileTyping="True">
                                                        <AutomationProperties.Name>
                                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                                <Binding Path="Name" />
                                                                <Binding Source="{x:Static loc:LocalizationSource.Instance}" Path="[Belts_ColMinWait]" />
                                                            </MultiBinding>
                                                        </AutomationProperties.Name>
                                                    </ctl:NumberBox>
                                                    <TextBlock Text="{Binding MinWaitProblem}" Style="{StaticResource ProblemText}"
                                                               Visibility="{Binding MinWaitProblem, Converter={StaticResource StringToVisibility}}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Loc Belts_FormNoOtherBelts}" Style="{StaticResource MutedText}"
                                       Visibility="{Binding PrerequisiteOptions.Count, Converter={StaticResource ZeroToVisible}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:Loc Belts_Save}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                                    <Setter Property="Text" Value="{loc:Loc Belts_Create}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding CancelFormCommand}" Content="{loc:Loc Belts_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nothing is deleted before this question is answered -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding ConfirmDeleteCommand}" Content="{loc:Loc Belts_ConfirmYes}" />
                            <Button Command="{Binding CancelDeleteCommand}" Content="{loc:Loc Belts_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- The belts, in the order of the progression -->
                <Border Style="{StaticResource ListCard}" Margin="0,16,0,0">
                    <DataGrid ItemsSource="{Binding Belts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" MinRowHeight="52" FontSize="13"
                              ColumnHeaderStyle="{StaticResource GridHeader}" SelectionMode="Single"
                              KeyboardNavigation.TabNavigation="Continue"
                              Background="Transparent" BorderThickness="0"
                              AutomationProperties.Name="{loc:Loc Nav_Belts}" PreviewMouseWheel="OnGridMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc Belts_ColBelt}" Width="220" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <ctl:BeltSwatch Color="{Binding PrimaryColor}" Stripe="{Binding SecondaryColor}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Loc Belts_ColPrerequisites}" Binding="{Binding PrerequisitesText, Mode=OneWay}"
                                                Width="*" MinWidth="140" ElementStyle="{StaticResource TextCell}" />

                            <DataGridTextColumn Binding="{Binding MemberCount, Mode=OneWay}" Width="100" MinWidth="90" ElementStyle="{StaticResource NumberCell}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Loc Belts_ColMembers}" Style="{StaticResource NumberHeader}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <!-- Wide enough for both buttons in both languages: an automatic width is not worked out again when the language changes.
                                 Somebody who may not change belts has no use for the column. -->
                            <DataGridTemplateColumn Width="200" MinWidth="190"
                                                    Visibility="{Binding Data.CanEdit, Source={StaticResource Page}, Converter={StaticResource BoolToVisibility}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Button Content="{loc:Loc Belts_Edit}"
                                                    Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <!-- A belt in use cannot be deleted: the button is off and its tooltip says why. -->
                                            <Button Content="{loc:Loc Belts_Delete}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding DeleteBlockedText}" ToolTipService.ShowOnDisabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}" TextAlignment="Center" MaxWidth="560"
                           Text="{Binding EmptyText}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Somebody who may not see the belts gets here only by a mistake of the navigation: the API would refuse them anyway. -->
        <TextBlock Style="{StaticResource NotAllowedText}" Text="{loc:Loc Page_NotAllowed}"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
