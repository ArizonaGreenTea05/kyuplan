<UserControl x:Class="Kyuplan.Client.WpfApp.Controls.EventPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared"
             x:Name="Root" IsTabStop="False">

    <!-- Picks one event of a long list: the date comes first (a small calendar page), and the list is searched by
         name or date. Replaces a ComboBox, which cannot do either. SelectedId is a plain event id and binds two-way. -->
    <UserControl.Resources>
        <!-- A calendar page: weekday, day of the month, month. -->
        <DataTemplate x:Key="DateBadge" DataType="{x:Type vm:EventOption}">
            <Border Width="46" VerticalAlignment="Center" BorderThickness="1" CornerRadius="4"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <!-- The line heights are set, otherwise the three lines of the Windows type ramp make the page twice as tall as it is wide. -->
                <StackPanel>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="3,3,0,0" Padding="0,1">
                        <TextBlock Text="{Binding Weekday, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   LineHeight="12" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding DayNumber, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,1,0,0"
                               LineHeight="22" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Text="{Binding MonthText, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,3"
                               LineHeight="11" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EventRow" DataType="{x:Type vm:EventOption}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DateBadge}" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EventName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DateText, Mode=OneWay}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding TimeText, Mode=OneWay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The field: the chosen event by its date; a click opens the list. -->
        <Button x:Name="Trigger" Click="OnTriggerClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                MinHeight="56" Padding="8,6"
                AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl Content="{Binding Selected, ElementName=Root}" ContentTemplate="{StaticResource DateBadge}" Focusable="False" />

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Selected.EventName, ElementName=Root, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Selected.DateText, ElementName=Root, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Selected.TimeText, ElementName=Root, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Shown while no event is chosen. -->
                <TextBlock Grid.Column="1" Margin="4,0" VerticalAlignment="Center" Text="{loc:Loc Stats_ChooseEvent}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2" Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE70D;"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>

        <!-- The list: a search box over the events that fit it. -->
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Trigger}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Opened="OnPopupOpened" Closed="OnPopupClosed">
            <Border MinWidth="380" Width="{Binding ActualWidth, ElementName=Trigger}" Padding="8" BorderThickness="1"
                    Background="{DynamicResource ComboBoxDropDownBackground}"
                    BorderBrush="{DynamicResource ComboBoxDropDownBorderBrush}"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ctl:HintedTextBox x:Name="Search" Glyph="&#xE721;" Hint="{loc:Loc Stats_SearchEvents}"
                                       Text="{Binding SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                       PreviewKeyDown="OnSearchKeyDown"
                                       AutomationProperties.Name="{loc:Loc Stats_SearchEvents}" />

                    <ListBox x:Name="List" Grid.Row="1" AutomationProperties.Name="{loc:Loc Stats_ChooseEvent}" MaxHeight="336" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource EventRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnListClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock x:Name="NoMatches" Grid.Row="1" Margin="8,14,8,8" Text="{loc:Loc Stats_NoEventMatches}"
                               Style="{StaticResource MutedText}" Visibility="Collapsed" />
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
