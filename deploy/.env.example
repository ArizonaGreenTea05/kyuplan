# Copy to ".env" next to the Compose file. Every value is optional except POSTGRES_PASSWORD for docker-compose.postgres.yml.

# The image: a version of the "v<version>" releases without the "v" (e.g. :0.1), or :latest.
# KYUPLAN_IMAGE=ghcr.io/arizonagreentea05/kyuplan:0.1
# The port on this host.
# KYUPLAN_PORT=8080

# docker-compose.postgres.yml: the password of the database user "kyuplan". Letters and digits are the safe choice.
POSTGRES_PASSWORD=

# docker-compose.yml: only if the settings should not be typed in the web client (see the comments there).
# SPOND_EMAIL=
# SPOND_PASSWORD=
# ADMIN_PASSWORD=
