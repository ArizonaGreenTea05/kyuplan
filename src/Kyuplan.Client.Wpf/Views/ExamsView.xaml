<UserControl x:Class="Kyuplan.Client.WpfApp.Views.ExamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:Kyuplan.Contracts;assembly=Kyuplan.Contracts"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:vm="clr-namespace:Kyuplan.Client.ViewModels;assembly=Kyuplan.Client.Shared">

    <UserControl.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelText}">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- What a belt asks for, in the colour of how it is met: fine as it is, missed (amber), not known (grey, slanted). -->
        <Style x:Key="AgeCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AgeState}" Value="NotMet">
                    <Setter Property="Foreground" Value="{DynamicResource DataOpenTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AgeState}" Value="Unknown">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WaitCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WaitState}" Value="NotMet">
                    <Setter Property="Foreground" Value="{DynamicResource DataOpenTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WaitState}" Value="Unknown">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StarsCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StarsState}" Value="NotMet">
                    <Setter Property="Foreground" Value="{DynamicResource DataOpenTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpcoming}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DataYesTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VerdictPill" TargetType="Border" BasedOn="{StaticResource PillBorder}">
            <Setter Property="Margin" Value="8,0,8,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="Fit">
                    <Setter Property="Background" Value="{DynamicResource DataYesWashBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DataYesTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="NotYet">
                    <Setter Property="Background" Value="{DynamicResource DataOpenWashBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DataOpenTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A line under every row, like the grid lines of the other pages. -->
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="0,8" />
        </Style>

        <!-- A belt: its strap and its name. -->
        <DataTemplate x:Key="BeltItem" DataType="{x:Type vm:BeltOption}">
            <StackPanel Orientation="Horizontal">
                <ctl:BeltSwatch Color="{Binding Color}" Stripe="{Binding SecondaryColor}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- ===== The list of exams ===== -->
        <DataTemplate x:Key="ExamItem" DataType="{x:Type vm:ExamRow}">
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExamDate" MinWidth="130" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExamName" MinWidth="200" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExamWhen" MinWidth="120" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExamPeople" MinWidth="150" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ExamExtra" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Weekday}" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource WhenCell}" />
                <TextBlock Grid.Column="3" Text="{Binding PeopleText}" Style="{StaticResource CellText}" />
                <TextBlock Grid.Column="4" Text="{Binding ExtraText}" Style="{StaticResource CellText}" />
            </Grid>
        </DataTemplate>

        <!-- ===== One member in the suggestions ===== -->
        <DataTemplate x:Key="SuggestionItem" DataType="{x:Type vm:SuggestionRow}">
            <Border Style="{StaticResource RowLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- The tick column has its minimum width in its cells, not here: somebody who may not save members for the exam
                             sees no ticks, and then the column takes no room. -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Pick" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Member" MinWidth="150" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Belts" MinWidth="150" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Age" MinWidth="100" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Wait" MinWidth="120" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Stars" MinWidth="100" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Attendance" MinWidth="150" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Last" MinWidth="100" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Verdict" MinWidth="230" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Spond" MinWidth="110" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" MinWidth="44"
                            Visibility="{Binding DataContext.Detail.CanPlan, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"
                                  AutomationProperties.Name="{Binding Name}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SubGroupsText}" Style="{StaticResource MutedText}" MaxWidth="170" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- The belt held, and under it the belt they would take -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                        <StackPanel Orientation="Horizontal">
                            <ctl:BeltSwatch Color="{Binding Belt.Color}" Stripe="{Binding Belt.SecondaryColor}" Margin="0,0,8,0" Width="32"
                                            Visibility="{Binding HasBelt, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Belt.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBelt}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding HasNextBelt, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#x2192;" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ctl:BeltSwatch Color="{Binding NextBelt.Color}" Stripe="{Binding NextBelt.SecondaryColor}" Margin="0,0,8,0" Width="32" />
                            <TextBlock Text="{Binding NextBelt.Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding AgeText}" Style="{StaticResource AgeCell}" />
                    <TextBlock Grid.Column="4" Text="{Binding WaitText}" Style="{StaticResource WaitCell}" ToolTip="{Binding WaitTip}" />
                    <TextBlock Grid.Column="5" Text="{Binding StarsText}" Style="{StaticResource StarsCell}" ToolTip="{loc:Loc Rating_StarsTip}" />

                    <StackPanel Grid.Column="6" VerticalAlignment="Center" Margin="8,0">
                        <Grid Height="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" MinWidth="44" />
                            </Grid.ColumnDefinitions>
                            <ctl:RateBar Grid.Column="0" Fraction="{Binding AttendanceFraction}" Style="{StaticResource MemberRateBar}"
                                         AutomationProperties.Name="{Binding AttendanceAriaText}" />
                            <TextBlock Grid.Column="2" Text="{Binding AttendanceText}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding AttendedOfInvitedText}" Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <TextBlock Grid.Column="7" Text="{Binding LastExamText}" Style="{StaticResource CellText}" />

                    <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="0,2">
                        <Border Style="{StaticResource VerdictPill}" ToolTip="{Binding VerdictTip}">
                            <TextBlock Text="{Binding VerdictText}" />
                        </Border>
                        <TextBlock Text="{Binding ReasonText}" Style="{StaticResource MutedText}" Margin="8,3,8,0" MaxWidth="300"
                                   Visibility="{Binding ReasonText, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="9" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="{Binding InvitationText}" />
                        <TextBlock Text="{loc:Loc Plan_SavedMark}" Foreground="{DynamicResource DataYesTextBrush}" FontWeight="SemiBold"
                                   Style="{StaticResource MutedText}"
                                   Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== One attendee with the belt they received ===== -->
        <DataTemplate x:Key="AttendeeItem" DataType="{x:Type vm:AttendeeRow}">
            <Border Style="{StaticResource RowLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AttName" MinWidth="220" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AttAnswer" MinWidth="130" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="AttBelt" MinWidth="240" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding AnswerText}" Style="{StaticResource CellText}" />
                    <!-- Somebody who may record the belts chooses them; for everybody else the belt received is only text. -->
                    <ComboBox Grid.Column="2" Margin="8,0" MinWidth="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding DataContext.Detail.BeltOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding SelectedBelt}" ItemTemplate="{StaticResource BeltItem}"
                              AutomationProperties.Name="{Binding Name}"
                              Visibility="{Binding DataContext.Detail.CanRecordResults, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    <ContentControl Grid.Column="2" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsTabStop="False"
                                    Content="{Binding SelectedBelt}" ContentTemplate="{StaticResource BeltItem}"
                                    Visibility="{Binding DataContext.Detail.CanRecordResults, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Somebody who has not paid at all stands out. -->
        <Style x:Key="PaymentStatusText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Open">
                    <Setter Property="Foreground" Value="{DynamicResource DataRiskTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== What each member pays for the exam ===== -->
        <DataTemplate x:Key="PaymentItem" DataType="{x:Type vm:PaymentRow}">
            <Border Style="{StaticResource RowLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayName" MinWidth="180" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayBelt" MinWidth="150" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayGeneral" MinWidth="80" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayStamp" MinWidth="80" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayBeltPrice" MinWidth="130" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayDue" MinWidth="90" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayPaid" MinWidth="110" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayNote" MinWidth="200" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayStatus" MinWidth="150" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PayActions" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                    <ContentControl Grid.Column="1" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsTabStop="False"
                                    Content="{Binding Belt}" ContentTemplate="{StaticResource BeltItem}" />
                    <TextBlock Grid.Column="2" Text="{Binding GeneralFeeText}" Style="{StaticResource CellText}" />
                    <TextBlock Grid.Column="3" Text="{Binding StampFeeText}" Style="{StaticResource CellText}" />
                    <StackPanel Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BeltPriceText}" Style="{StaticResource CellText}" />
                        <CheckBox Content="{loc:Loc Pay_OwnBelt}" IsChecked="{Binding OwnBelt}" IsEnabled="{Binding CanEdit}"
                                  ToolTip="{loc:Loc Pay_OwnBeltHint}" />
                    </StackPanel>
                    <TextBlock Grid.Column="5" Text="{Binding DueText}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                    <TextBox Grid.Column="6" Margin="8,0" Width="96" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding Name}"
                             Text="{Binding Paid.Text, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}" />
                    <TextBox Grid.Column="7" Margin="8,0" Width="184" VerticalAlignment="Center" MaxLength="{x:Static contracts:PaymentRules.MaxNoteLength}"
                             AutomationProperties.Name="{Binding Name}"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}" />
                    <StackPanel Grid.Column="8" Margin="8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource PaymentStatusText}" />
                        <TextBlock Text="{Binding PaidOnText}" Style="{StaticResource MutedText}"
                                   Visibility="{Binding PaidOnText, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding MarkPaidCommand}" Content="{loc:Loc Pay_MarkPaid}" />
                        <Button Command="{Binding SaveCommand}" Content="{loc:Loc Pay_Save}" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24,6,24,24">

                <!-- Title and the button that adds an exam -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding BeginAddCommand}" VerticalAlignment="Bottom"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE710;" />
                            <TextBlock Text="{loc:Loc Exams_Add}" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Text="{loc:Loc Exams_Lede}" Style="{StaticResource LedeText}" />
                    </StackPanel>
                </DockPanel>

                <!-- What went wrong / what was achieved. Trying again only makes sense while there is no list. -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" Content="{loc:Loc Shell_TryAgain}" Margin="12,0,0,0"
                                Visibility="{Binding HasLoaded, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource NoticeBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>

                <!-- An exam is a Spond event: a new one is made by choosing the event -->
                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                        Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Exams_AddTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{loc:Loc Exams_AddEvent}" Style="{StaticResource FieldLabelText}" />
                        <ctl:EventPicker Options="{Binding EventOptions}" SelectedId="{Binding NewEventId}" MaxWidth="560" HorizontalAlignment="Left"
                                         AutomationProperties.Name="{loc:Loc Exams_AddEvent}" />
                        <TextBlock Text="{loc:Loc Exams_AddHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSubGroups, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Exams_AddSubGroups}" Style="{StaticResource FieldLabelText}" />
                            <ctl:SubGroupPicker Options="{Binding SubGroupOptions}" Summary="{Binding SubGroupSummary}"
                                                IsEveryone="{Binding IsEveryoneSelected, Mode=OneWay}"
                                                ClearCommand="{Binding ClearSubGroupsCommand}"
                                                MinWidth="220" MaxWidth="560" HorizontalAlignment="Left"
                                                AutomationProperties.Name="{loc:Loc Exams_AddSubGroups}" />
                            <TextBlock Text="{loc:Loc Exams_AddSubGroupsHint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Command="{Binding AddCommand}" Content="{loc:Loc Exams_AddSave}" Style="{StaticResource AccentButtonStyle}" />
                            <Button Command="{Binding CancelAddCommand}" Content="{loc:Loc Saved_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nothing is deleted before this question is answered -->
                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding ConfirmDeleteCommand}" Content="{loc:Loc Saved_ConfirmYes}" />
                            <Button Command="{Binding CancelDeleteCommand}" Content="{loc:Loc Saved_Cancel}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource LedeText}"
                           Text="{loc:Loc Exams_None}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <!-- The exams: the ones to come first, then the ones that took place -->
                <Border Margin="0,16,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Setter Property="Padding" Value="0,0,0,4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Exams.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnInnerWheel">
                            <StackPanel>
                                <Grid Margin="4,10,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExamDate" MinWidth="130" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExamName" MinWidth="200" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExamWhen" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExamPeople" MinWidth="150" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ExamExtra" MinWidth="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Loc Exams_ColDate}" Style="{StaticResource HeaderText}" />
                                    <TextBlock Grid.Column="1" Text="{loc:Loc Exams_ColExam}" Style="{StaticResource HeaderText}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Exams_ColWhen}" Style="{StaticResource HeaderText}" />
                                    <TextBlock Grid.Column="3" Text="{loc:Loc Exams_ColAccepted}" Style="{StaticResource HeaderText}" />
                                    <TextBlock Grid.Column="4" Text="{loc:Loc Exams_ColPlan}" Style="{StaticResource HeaderText}" />
                                </Grid>
                                <ListBox ItemsSource="{Binding Exams}" SelectedItem="{Binding SelectedExam}" ItemTemplate="{StaticResource ExamItem}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseWheel="OnInnerWheel" HorizontalContentAlignment="Left"
                                         AutomationProperties.Name="{Binding Title}" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- The exam on show -->
                <StackPanel DataContext="{Binding Detail}" Margin="0,22,0,0"
                            Visibility="{Binding HasExam, Converter={StaticResource BoolToVisibility}}">

                    <DockPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconTextBlock}" Text="&#xE74D;" />
                                <TextBlock Text="{loc:Loc Exams_Delete}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Style="{StaticResource BannerBorder}" Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Border>
                    <Border Style="{StaticResource NoticeBorder}" Margin="0,12,0,0"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Border>

                    <!-- ===== Who is fit for the exam ===== -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                            Visibility="{Binding ShowsPlan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Plan_Title}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:Loc Plan_Lede}" Style="{StaticResource LedeText}" Margin="0,0,0,14" />

                            <TextBlock Text="{loc:Loc Plan_Basis}" Style="{StaticResource FieldLabelText}" />
                            <ComboBox ItemsSource="{Binding BasisOptions}" SelectedItem="{Binding SelectedBasis}" DisplayMemberPath="Label"
                                      HorizontalAlignment="Left" MinWidth="360" MaxWidth="640"
                                      AutomationProperties.Name="{loc:Loc Plan_Basis}" />
                            <TextBlock Text="{loc:Loc Plan_BasisHint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Visibility="{Binding DataContext.CanOpenStatistics, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                <Hyperlink Command="{Binding DataContext.OpenStatisticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Run Text="{loc:Loc Plan_BasisDefine}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding BasisSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Visibility="{Binding BasisSummary, Converter={StaticResource StringToVisibility}}" />

                            <Border Style="{StaticResource BannerBorder}" Margin="0,14,0,0"
                                    Visibility="{Binding HasNoBelts, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Plan_NoBelts}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,16,0,10">
                                    <ctl:HintedTextBox DockPanel.Dock="Right" Width="250" Glyph="&#xE721;"
                                                       Hint="{loc:Loc Stats_FindMember}"
                                                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                       AutomationProperties.Name="{loc:Loc Stats_FindMember}" />
                                    <ListBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                                             HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseWheel="OnInnerWheel"
                                             AutomationProperties.Name="{loc:Loc Plan_Show}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SuggestionFilterOption}">
                                                <TextBlock Text="{Binding Label}" Margin="4,0" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource LedeText}" Margin="0,20,0,20" HorizontalAlignment="Center"
                                           Visibility="{Binding NoneMatch, Converter={StaticResource BoolToVisibility}}" />

                                <!-- The members: a table whose columns are sized together -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnInnerWheel"
                                              Visibility="{Binding NoneMatch, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel Grid.IsSharedSizeScope="True">
                                        <Border Style="{StaticResource RowLine}" Padding="0,0,0,6" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Pick" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Member" MinWidth="150" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Belts" MinWidth="150" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Age" MinWidth="100" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Wait" MinWidth="120" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Stars" MinWidth="100" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Attendance" MinWidth="150" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Last" MinWidth="100" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Verdict" MinWidth="230" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Spond" MinWidth="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Loc Plan_ColSave}" Style="{StaticResource HeaderText}" HorizontalAlignment="Center"
                                                           TextAlignment="Center" MinWidth="44" Margin="0"
                                                           Visibility="{Binding CanPlan, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Column="1" Text="{loc:Loc Col_Member}" Style="{StaticResource HeaderText}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{loc:Loc Belts_ColBelt}" Style="{StaticResource HeaderText}" Margin="8,0,4,0" />
                                                    <TextBlock Text="&#x2192;" Style="{StaticResource HeaderText}" Margin="0" />
                                                    <TextBlock Text="{loc:Loc Plan_ColNext}" Style="{StaticResource HeaderText}" Margin="4,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{loc:Loc Plan_ColAge}" Style="{StaticResource HeaderText}" />
                                                <TextBlock Grid.Column="4" Text="{loc:Loc Plan_ColWait}" Style="{StaticResource HeaderText}" />
                                                <TextBlock Grid.Column="5" Text="{loc:Loc Plan_ColStars}" Style="{StaticResource HeaderText}" ToolTip="{loc:Loc Rating_StarsTip}" />
                                                <TextBlock Grid.Column="6" Text="{loc:Loc Plan_ColAttendance}" Style="{StaticResource HeaderText}" />
                                                <TextBlock Grid.Column="7" Text="{loc:Loc Plan_ColLastExam}" Style="{StaticResource HeaderText}" />
                                                <TextBlock Grid.Column="8" Text="{loc:Loc Plan_ColVerdict}" Style="{StaticResource HeaderText}" />
                                                <TextBlock Grid.Column="9" Text="{loc:Loc Plan_ColSpond}" Style="{StaticResource HeaderText}" />
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding VisibleSuggestions}" ItemTemplate="{StaticResource SuggestionItem}"
                                                      IsTabStop="False" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Selecting and saving: only for somebody who may save members for the exam; the buttons are only enabled while they would change something -->
                                <DockPanel Margin="0,16,0,0" Visibility="{Binding CanPlan, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Command="{Binding DiscardChangesCommand}" Content="{loc:Loc Plan_Discard}" />
                                        <Button Command="{Binding SaveSelectionCommand}" Content="{loc:Loc Plan_Save}" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding SelectFitCommand}" Content="{loc:Loc Plan_SelectFit}" />
                                        <Button Command="{Binding ClearSelectionCommand}" Content="{loc:Loc Plan_ClearSelection}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{loc:Loc Plan_SaveHint}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                           Visibility="{Binding CanPlan, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding SavedNotInvitedText}" Style="{StaticResource MutedText}" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Visibility="{Binding HasSavedNotInvited, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Who attended, and which belt each received ===== -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                            Visibility="{Binding ShowsResults, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Res_Title}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:Loc Res_Lede}" Style="{StaticResource LedeText}" Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding ResultKpis}" ItemTemplate="{StaticResource KpiCompactTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <TextBlock Text="{loc:Loc Res_Nobody}" Style="{StaticResource LedeText}" Margin="0,18,0,4"
                                       Visibility="{Binding NobodyAttended, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,16,0,0"
                                        Visibility="{Binding HasAttendees, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource RowLine}" Padding="0,0,0,6" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AttName" MinWidth="220" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AttAnswer" MinWidth="130" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AttBelt" MinWidth="240" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc Col_Member}" Style="{StaticResource HeaderText}" />
                                        <TextBlock Grid.Column="1" Text="{loc:Loc Res_ColAnswer}" Style="{StaticResource HeaderText}" />
                                        <TextBlock Grid.Column="2" Text="{loc:Loc Res_ColBelt}" Style="{StaticResource HeaderText}" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Attendees}" ItemTemplate="{StaticResource AttendeeItem}" IsTabStop="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== What each member owes for the exam, and what was paid ===== -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0"
                            Visibility="{Binding CanViewPayments, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Pay_Title}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,2" />
                            <TextBlock Text="{loc:Loc Pay_Intro}" Style="{StaticResource LedeText}" Margin="0,0,0,14" />

                            <TextBlock Text="{loc:Loc Pay_Empty}" Style="{StaticResource LedeText}" Margin="0,4,0,4"
                                       Visibility="{Binding NobodyPays, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding PaymentTotalsText}" FontWeight="SemiBold" />
                                    <TextBlock Text=" · " Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding PaymentCountsText}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnInnerWheel">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <Border Style="{StaticResource RowLine}" Padding="0,0,0,6" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayName" MinWidth="180" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayBelt" MinWidth="150" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayGeneral" MinWidth="80" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayStamp" MinWidth="80" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayBeltPrice" MinWidth="130" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayDue" MinWidth="90" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayPaid" MinWidth="110" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayNote" MinWidth="200" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayStatus" MinWidth="150" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="PayActions" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Pay_Member}" Style="{StaticResource HeaderText}" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc Pay_Belt}" Style="{StaticResource HeaderText}" Margin="8,0" />
                                            <TextBlock Grid.Column="2" Text="{loc:Loc Pay_General}" Style="{StaticResource HeaderText}" />
                                            <TextBlock Grid.Column="3" Text="{loc:Loc Pay_Stamp}" Style="{StaticResource HeaderText}" />
                                            <TextBlock Grid.Column="4" Text="{loc:Loc Pay_BeltPrice}" Style="{StaticResource HeaderText}" />
                                            <TextBlock Grid.Column="5" Text="{loc:Loc Pay_Due}" Style="{StaticResource HeaderText}" />
                                            <TextBlock Grid.Column="6" Text="{loc:Loc Pay_Paid}" Style="{StaticResource HeaderText}" Margin="8,0" />
                                            <TextBlock Grid.Column="7" Text="{loc:Loc Pay_Note}" Style="{StaticResource HeaderText}" Margin="8,0" />
                                            <TextBlock Grid.Column="8" Text="{loc:Loc Col_Status}" Style="{StaticResource HeaderText}" Margin="8,0" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding PaymentRows}" ItemTemplate="{StaticResource PaymentItem}" IsTabStop="False" />
                                </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Somebody who may not see the exams gets here only by a mistake of the navigation: the API would refuse them anyway. -->
        <TextBlock Style="{StaticResource NotAllowedText}" Text="{loc:Loc Page_NotAllowed}"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="0,-6,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="0,-6,0,0"
                     Visibility="{Binding Detail.IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
