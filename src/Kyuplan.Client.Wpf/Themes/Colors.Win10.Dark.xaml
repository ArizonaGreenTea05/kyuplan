<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design "Windows 10", dark: same keys as Colors.Win10.Light.xaml. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6E6E6E" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#404040" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#404040" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#333333" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#4D4D4D" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#3B3B3B" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#454545" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#8C8C8C" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#5E5E5E" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#B8B8B8" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#2F2F2F" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#4D4D4D" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#8C8C8C" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#C9C9C9" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#FFFFFF" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#3A3A3A" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#454545" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#5A5A5A" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#7C7C7C" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#A6A6A6" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#4D4D4D" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#E0E0E0" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#B3B3B3" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#404040" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
