<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme "Catppuccin Mocha" (dark only): same keys as Colors.Win10.Light.xaml. -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#CDD6F4" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A6ADC8" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7F849C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#585B70" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppWindowBrush" Color="#1E1E2E" />
    <SolidColorBrush x:Key="AppNavPaneBrush" Color="#181825" />
    <SolidColorBrush x:Key="AppNavSelectedBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#24243A" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#11111B" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#28283C" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#313244" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#313244" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#585B70" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#313244" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#313244" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#24243A" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#585B70" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="CtlButtonBackground" Color="#313244" />
    <SolidColorBrush x:Key="CtlButtonBorder" Color="#313244" />
    <SolidColorBrush x:Key="CtlButtonInnerBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlButtonHoverBackground" Color="#45475A" />
    <SolidColorBrush x:Key="CtlButtonHoverBorder" Color="#585B70" />
    <SolidColorBrush x:Key="CtlButtonPressedBackground" Color="#585B70" />
    <SolidColorBrush x:Key="CtlButtonPressedBorder" Color="#313244" />
    <SolidColorBrush x:Key="CtlButtonFocusBorder" Color="#A6ADC8" />
    <SolidColorBrush x:Key="CtlButtonDisabledBackground" Color="#252536" />
    <SolidColorBrush x:Key="CtlButtonDisabledBorder" Color="Transparent" />

    <!-- Boxes -->
    <SolidColorBrush x:Key="CtlInputBackground" Color="#11111B" />
    <SolidColorBrush x:Key="CtlInputFocusBackground" Color="#11111B" />
    <SolidColorBrush x:Key="CtlInputDisabledBackground" Color="#252536" />
    <SolidColorBrush x:Key="CtlInputBorder" Color="#585B70" />
    <SolidColorBrush x:Key="CtlInputHoverBorder" Color="#A6ADC8" />

    <!-- Tick boxes, radio buttons -->
    <SolidColorBrush x:Key="CtlGlyphBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphHoverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlGlyphBorder" Color="#A6ADC8" />
    <SolidColorBrush x:Key="CtlGlyphHoverBorder" Color="#CDD6F4" />

    <!-- Lists -->
    <SolidColorBrush x:Key="CtlListHoverBackground" Color="#313244" />
    <SolidColorBrush x:Key="CtlListHoverBorder" Color="Transparent" />

    <!-- Progress, scroll bars, slider, table -->
    <SolidColorBrush x:Key="CtlProgressTrack" Color="#313244" />
    <SolidColorBrush x:Key="CtlProgressBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollTrack" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumb" Color="#45475A" />
    <SolidColorBrush x:Key="CtlScrollThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlScrollThumbHover" Color="#585B70" />
    <SolidColorBrush x:Key="CtlScrollThumbPressed" Color="#7F849C" />
    <SolidColorBrush x:Key="CtlScrollArrowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderTrack" Color="#585B70" />
    <SolidColorBrush x:Key="CtlSliderTrackBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumb" Color="#CDD6F4" />
    <SolidColorBrush x:Key="CtlSliderThumbBorder" Color="Transparent" />
    <SolidColorBrush x:Key="CtlSliderThumbHover" Color="#CDD6F4" />
    <SolidColorBrush x:Key="CtlSliderThumbPressed" Color="#A6ADC8" />
    <SolidColorBrush x:Key="CtlHeaderBackground" Color="Transparent" />
    <SolidColorBrush x:Key="CtlHeaderBorder" Color="#313244" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="AppTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AppTabHoverBrush" Color="Transparent" />
</ResourceDictionary>
