<UserControl x:Class="Kyuplan.Client.WpfApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Kyuplan.Client.WpfApp.Controls"
             xmlns:loc="clr-namespace:Kyuplan.Client.WpfApp.Localization"
             xmlns:converters="clr-namespace:Kyuplan.Client.WpfApp.Converters">

    <UserControl.Resources>
        <!-- One row of "Most engaged" / "Needs attention". -->
        <DataTemplate x:Key="MemberRowTemplate">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LevelPill" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding LastAttendedText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:RateBar Fraction="{Binding AttendanceFraction}" Style="{StaticResource MemberRateBar}"
                                 VerticalAlignment="Center" AutomationProperties.Name="{Binding AttendanceAriaText}" />
                    <TextBlock Grid.Column="1" Text="{Binding AttendanceText}" Margin="10,0,0,0" FontWeight="SemiBold"
                               VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding TrendGlyph}" Style="{StaticResource TrendText}"
                           HorizontalAlignment="Center" Margin="0" />
                <Border Grid.Column="3" Style="{StaticResource LevelPill}" ToolTip="{loc:Loc Col_EngagementTip}">
                    <TextBlock>
                        <Run Text="{Binding EngagementScore, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding LevelText, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding CanView, Converter={StaticResource BoolToVisibility}}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
            <StackPanel Margin="24,6,24,32">

                <!-- Title + period -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{loc:Loc Dashboard_Period}" Style="{StaticResource FieldLabelText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" />
                        <ComboBox MinWidth="170" ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Days" SelectedValue="{Binding SelectedDays}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
                        <TextBlock Style="{StaticResource LedeText}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1}">
                                    <Binding Path="GroupName" />
                                    <Binding Path="PeriodText" />
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Visibility>
                                <Binding Path="HasData" Converter="{StaticResource BoolToVisibility}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <TextBlock Text="{Binding Lede}" Style="{StaticResource LedeText}"
                                   Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="{loc:Loc Shell_TryAgain}" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

                    <!-- Key figures -->
                    <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctl:ResponsiveGrid MinItemWidth="168" Gap="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ctl:ResponsiveGrid MinItemWidth="460" Gap="14" Margin="0,14,0,0">
                        <!-- Upcoming events -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Dashboard_Upcoming}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{loc:Loc Dashboard_NothingScheduled}" Style="{StaticResource MutedText}"
                                           Visibility="{Binding Upcoming.Count, Converter={StaticResource ZeroToVisible}}" />
                                <ItemsControl ItemsSource="{Binding Upcoming}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StartText}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <ctl:StackedBar Style="{StaticResource RsvpBar}"
                                                                    Yes="{Binding AcceptedFraction}" No="{Binding DeclinedFraction}"
                                                                    Open="{Binding UnansweredFraction}" Margin="0,0,0,5"
                                                                    AutomationProperties.Name="{Binding AriaText}" />
                                                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel Margin="0,2,0,0">
                                    <Border Style="{StaticResource LegendSquare}" Background="{DynamicResource DataYesBrush}" />
                                    <TextBlock Text="{loc:Loc Legend_Coming}" Style="{StaticResource MutedText}" Margin="0,0,16,0" />
                                    <Border Style="{StaticResource LegendSquare}" Background="{DynamicResource DataNoBrush}" />
                                    <TextBlock Text="{loc:Loc Legend_Declined}" Style="{StaticResource MutedText}" Margin="0,0,16,0" />
                                    <Border Style="{StaticResource LegendSquare}" Background="{DynamicResource DataOpenBrush}" />
                                    <TextBlock Text="{loc:Loc Legend_NoAnswerYet}" Style="{StaticResource MutedText}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Monthly attendance -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Chart_TrendTitle}" Style="{StaticResource SectionTitleText}" />
                                <ctl:ColumnChart Bars="{Binding Trend}" Style="{StaticResource AttendanceColumnChart}"
                                                 AutomationProperties.Name="{loc:Loc Chart_TrendAria}" />
                                <TextBlock Text="{loc:Loc Chart_TrendNoteDashboard}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </ctl:ResponsiveGrid>

                    <ctl:ResponsiveGrid MinItemWidth="460" Gap="14" Margin="0,14,0,0">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Dashboard_TopMembers}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{loc:Loc Dashboard_TopMembersEmpty}" Style="{StaticResource MutedText}"
                                           Visibility="{Binding TopMembers.Count, Converter={StaticResource ZeroToVisible}}" />
                                <ItemsControl ItemsSource="{Binding TopMembers}" ItemTemplate="{StaticResource MemberRowTemplate}" Grid.IsSharedSizeScope="True" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Dashboard_NeedsAttention}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{loc:Loc Dashboard_NeedsAttentionEmpty}" Style="{StaticResource MutedText}"
                                           Visibility="{Binding NeedsAttention.Count, Converter={StaticResource ZeroToVisible}}" />
                                <ItemsControl ItemsSource="{Binding NeedsAttention}" ItemTemplate="{StaticResource MemberRowTemplate}" Grid.IsSharedSizeScope="True" />
                            </StackPanel>
                        </Border>
                    </ctl:ResponsiveGrid>
                </StackPanel>

                <TextBlock Text="{loc:Loc Dashboard_Empty}" Style="{StaticResource LedeText}" HorizontalAlignment="Center" Margin="0,48,0,0"
                           Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Somebody who may not see the dashboard gets here only by a mistake of the navigation: the API would refuse them anyway. -->
        <TextBlock Style="{StaticResource NotAllowedText}" Text="{loc:Loc Page_NotAllowed}"
                   Visibility="{Binding CanView, Converter={StaticResource InverseBoolToVisibility}}" />

        <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
